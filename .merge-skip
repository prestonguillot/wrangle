# Items skipped during `wrangle merge` via the [f]orever prompt action.
# wrangle merge silently skips entries listed here. Bypass with --force.
#
# Format: <domain> <item>
#   domain ∈ { dotfile, brew, fisher, univ }
#   item is the literal value the merge handler would compare:
#     dotfile → path under home/ (e.g. home/.config/zed/settings.json)
#     brew    → the full Brewfile line (e.g. brew "mergiraf")
#     fisher  → the plugin identifier (e.g. PatrickF1/fzf.fish)
#     univ    → the .univexport pattern (e.g. tide_*)
#
# Comments (#) and blank lines are ignored.
dotfile home/.config/opencode/opencode.json
brew brew "awscli"
brew brew "kubernetes-cli"
brew brew "metals"
brew brew "python@3.13"
brew brew "mkdocs"
brew brew "mysql-client"
brew brew "newrelic-cli"
brew brew "poppler"
brew brew "ankitpokhrel/jira-cli/jira-cli"
brew brew "ck-private/tap/ck-mcp-wrapper"
brew cask "fantastical"
brew cask "firefox@developer-edition"
brew cask "gcloud-cli"
brew cask "git-credential-manager"
brew cask "rancher"
brew mas "Okta Verify", id: 490179405
brew brew "stacklok/tap/thv"
dotfile home/.bash_profile
dotfile home/.bashrc
dotfile home/.gitconfig-work
brew cask "rancher", args: { appdir: "/Applications" }
brew brew "circleci"
brew brew "mise"
brew brew "coursier"
brew brew "just"
brew brew "openjdk@17"
brew brew "openjdk@21"
brew cask "corretto@8"
dotfile home/.jetbrains/acp.json
dotfile home/.zprofile
dotfile home/.zshenv
dotfile home/.zshrc
dotfile home/.config/mise/config.toml
brew brew "gum"
brew brew "lefthook"
