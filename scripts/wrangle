#!/usr/bin/env fish
# wrangle — the sync command. See README.md for the full picture.
#
# Branch model: machines are peers. Each owns one branch (the
# "machine-branch") and commits to it. Bootstrap initializes a new
# machine-branch from `main` (optionally seeded from another existing
# machine-branch's current state). After init, branches diverge freely.
# Two operations cross the gap:
#   - `wrangle update`         — merge framework updates (origin/main) into
#                                the current machine-branch.
#   - `wrangle merge <branch>` — per-domain, per-item adoption of personal-
#                                layer content from another machine-branch
#                                into the current one.
#
# Passes (in order):
#   1. Framework update     — fetch + merge origin/main into machine-branch
#   2. Yoink check          — broken symlinks in ~ → offer to remove from home/
#   3. Orphan-symlink check — dangling symlinks in ~ pointing into home/ → remove
#   4. Re-stow              — link any new files in home/ to ~
#   5. Dotfile drift        — untracked files in ~/.config + ~ → [t/i/s/q]
#   6. Fisher drift         — installed vs ~/.config/fish/fish_plugins → [t/i/s/q] or [i/r/s/q]
#   7. Univ-var drift       — import sub-pass (file → live, [a/k/s/q] on
#                              conflict, silent apply on missing) + capture
#                              sub-pass (live → file, per-prefix [t/i/s/q])
#   8. Brew drift           — installed vs Brewfile → [t/i/s/q] or [i/r/s/q]
#   9. Changelog            — append summary of changes to .wrangle-changelog
#  10. Commit               — secret-scan staged diff, commit with auto/llm message
#  11. Doc sync (opt-in)    — claude reviews + edits .md files; commits separately
#  12. Push                 — preview unpushed commits + stat; [y/N/d=diff] prompt
#
# The first-run "do you want claude doc-review?" opt-in question is asked
# UP FRONT (after the welcome banner, before drift detection) so the answer
# applies to this run's doc-sync, not just future runs.
#
# Prompts use consistent letters:
#   [t]rack          — capture into the repo
#   [a]dopt          — pull content from source branch (wrangle merge)
#   [i]gnore         — append to the per-pass skiplist (.dotignore / .brewignore /
#                      .fisherignore / .univignore); leaves local state alone
#   [k]eep mine      — keep current branch's value (wrangle merge conflict)
#   [d]iff           — show the difference (wrangle merge conflict, re-prompts)
#   [r]emove         — yoink/drop from the repo
#   [s]kip           — leave alone; ask again next run
#   [q]uit
#
# Flags:
#   -d, --dry-run             show drift without prompting (no changes, no commit)
#   -f, --force               re-ask about paths in .dotignore
#   --with-claude             force-on claude doc review this run (overrides opt-out file)
#   --suppress-claude         force-off claude this run (overrides opt-in file)
#   --no-branch-switch        skip the framework update at sync start
#   -h, --help
#
# Env vars:
#   Opt-outs (all features default-on when applicable):
#     WRANGLE_NO_COMMIT=1          skip auto-commit
#     WRANGLE_NO_PUSH=1            skip push prompt
#     WRANGLE_NO_PUSH_NAG=1        silence the unpushed-commits nag in new shells
#     WRANGLE_NO_PULL_NAG=1        silence the upstream-changes-pending nag in new shells
#     WRANGLE_NO_STALENESS_NAG=1   silence the "wrangle hasn't run in N days" nag
#     WRANGLE_NO_BRANCH_SWITCH=1   skip the framework update at sync start
#     WRANGLE_ALLOW_SECRETS=1      bypass scan-secrets at commit time
#   Claude tuning (defaults are fast/cheap; raise for heavier reasoning):
#     WRANGLE_CLAUDE_MODEL=sonnet  override claude model (alias or full name)
#     WRANGLE_CLAUDE_EFFORT=low    override effort: low|medium|high|xhigh|max
# Git config (per-clone):
#   wrangle.machine-branch <name>           which branch this machine owns (default: personal)

# ── FILE STRUCTURE ───────────────────────────────────────────────────────
# Sections in reading order. To jump to any entry, search the file for its
# label text — every entry corresponds to a `# ─── <label> ───` divider.
# Passes 5-8 live in scripts/_drift.fish, and the stow pre-flight, stow
# runner, and orphan-symlink scan in scripts/_stow_guard.fish; the rest are
# all in this file.
#
#   1. Preamble + subcommand dispatch
#   2. Help printers
#   3. Helper library sourcing
#   4. Color + spinner library
#   5. Early-exit subcommand handlers
#      5.1 Framework-update helper
#      5.2 update
#      5.3 merge
#      5.4 push
#      5.5 review-docs
#      5.6 status
#      5.7 repair
#   6. Commit-message builders
#   7. Sync pipeline
#      7.1  Pass 1: framework update
#      7.2  First-run welcome + claude opt-in
#      7.3  Pass 2: yoink check
#      7.4  Pass 3: orphan-symlink check
#      7.5  Pass 4: re-stow
#      7.6  Passes 5-8: drift detection
#      7.7  Touch timestamp
#      7.8  Pass 9: changelog
#      7.9  Pass 10: commit
#      7.10 Pass 11: claude-code doc review
#      7.11 Pass 12: push

# ─── Preamble + subcommand dispatch ──────────────────────────────────────
# Shape: `wrangle <subcmd> [<args>...]`. Bare `wrangle`, `wrangle -h`, and
# `wrangle --help` all print the top-level help (matching git's convention).
# Subcommands must be given explicitly — there's no default-to-sync shorthand.
set -g _subcmd
if test (count $argv) -eq 0
    set _subcmd help
else if test "$argv[1]" = -h; or test "$argv[1]" = --help
    set _subcmd help
    set -e argv[1]
else if string match -q -- '-*' $argv[1]
    echo "wrangle: '$argv[1]' is a flag, not a subcommand." >&2
    echo "Run `wrangle help` for a list of subcommands." >&2
    exit 2
else
    set _subcmd $argv[1]
    set -e argv[1]
end

# Reject unknown subcommands.
switch $_subcmd
    case sync update merge push review-docs status repair help
        # known — handled below
    case '*'
        echo "wrangle: unknown subcommand: $_subcmd" >&2
        echo "Run `wrangle help` for a list of subcommands." >&2
        exit 2
end

# Argparse: declares the UNION of all subcommand flags. We then validate
# per-subcommand which flags are allowed.
argparse h/help d/dry-run f/force v/verbose with-claude suppress-claude no-branch-switch -- $argv
or exit 1

# Per-subcommand flag-validity gate.
function _wrangle_reject_flag --argument-names subcmd flag
    echo "wrangle $subcmd: unknown option: $flag" >&2
    echo "Run `wrangle help $subcmd` for valid options." >&2
    exit 2
end
switch $_subcmd
    case sync
        # sync accepts all the configured flags; nothing to reject.
    case merge
        # merge accepts --force (bypasses .merge-skip). Reject everything else.
        # --verbose is rejected on merge: merge already prints ignore-match
        # info unconditionally, so the flag would be a confusing no-op.
        set -q _flag_dry_run;          and _wrangle_reject_flag merge --dry-run
        set -q _flag_verbose;          and _wrangle_reject_flag merge --verbose
        set -q _flag_with_claude;      and _wrangle_reject_flag merge --with-claude
        set -q _flag_suppress_claude;  and _wrangle_reject_flag merge --suppress-claude
        set -q _flag_no_branch_switch; and _wrangle_reject_flag merge --no-branch-switch
    case repair
        # repair accepts --dry-run (report all three phases, change nothing).
        set -q _flag_force;            and _wrangle_reject_flag repair --force
        set -q _flag_verbose;          and _wrangle_reject_flag repair --verbose
        set -q _flag_with_claude;      and _wrangle_reject_flag repair --with-claude
        set -q _flag_suppress_claude;  and _wrangle_reject_flag repair --suppress-claude
        set -q _flag_no_branch_switch; and _wrangle_reject_flag repair --no-branch-switch
    case update push review-docs status help
        # No flags besides --help.
        set -q _flag_dry_run;          and _wrangle_reject_flag $_subcmd --dry-run
        set -q _flag_force;            and _wrangle_reject_flag $_subcmd --force
        set -q _flag_verbose;          and _wrangle_reject_flag $_subcmd --verbose
        set -q _flag_with_claude;      and _wrangle_reject_flag $_subcmd --with-claude
        set -q _flag_suppress_claude;  and _wrangle_reject_flag $_subcmd --suppress-claude
        set -q _flag_no_branch_switch; and _wrangle_reject_flag $_subcmd --no-branch-switch
end

# ─── Help printers ───────────────────────────────────────────────────────
function _wrangle_help_top
    echo "Usage: wrangle <subcommand> [args]"
    echo ""
    echo "Subcommands:"
    echo "  sync                  detect drift + commit + push (the main workflow)"
    echo "  update                fetch + merge origin/main into the current machine-branch"
    echo "  merge <branch>        per-item adopt personal-layer content from another machine-branch"
    echo "  push                  push the current branch to origin (preview first)"
    echo "  status                fetch + report behind-origin/main, peer machine-branches, drift dry-run"
    echo "  review-docs           skip drift; have claude review docs against recent commits"
    echo "  repair                fix a home/ that stow refuses, and re-link what it stranded"
    echo "  help [<subcmd>]       this message, or detailed help for a subcommand"
    echo ""
    echo "Env-var knobs:"
    echo "  WRANGLE_NO_COMMIT             skip the commit pass"
    echo "  WRANGLE_NO_PUSH               skip the push pass"
    echo "  WRANGLE_NO_PUSH_NAG           silence unpushed-commits nag on shell start"
    echo "  WRANGLE_NO_PULL_NAG           silence upstream-changes-pending nag on shell start"
    echo "  WRANGLE_NO_STALENESS_NAG      silence \"hasn't run in N days\" nag on shell start"
    echo "  WRANGLE_NO_BRANCH_SWITCH      skip the framework update at sync start"
    echo "  WRANGLE_ALLOW_SECRETS         bypass scan-secrets at commit time"
    echo "  WRANGLE_CLAUDE_MODEL=sonnet   override claude model"
    echo "  WRANGLE_CLAUDE_EFFORT=low     override claude effort (low|medium|high|xhigh|max)"
    echo ""
    echo "Git config (per-clone):"
    echo "  wrangle.machine-branch <name>           which branch this machine owns (default: personal)"
end

function _wrangle_help_sync
    echo "Usage: wrangle sync [-d|--dry-run] [-f|--force] [-v|--verbose]"
    echo "                    [--with-claude|--suppress-claude]"
    echo "                    [--no-branch-switch]"
    echo ""
    echo "Find dotfile + plugin + univ-var + brew drift and (by default) prompt"
    echo "per-item what to do. Commits the result. Optionally pushes."
    echo ""
    echo "Options:"
    echo "  -d, --dry-run         detect drift, change nothing, no commit, no push"
    echo "  -f, --force           re-ask about paths already in .dotignore"
    echo "  -v, --verbose         emit a one-line note when an item is silently"
    echo "                        skipped by .dotignore / .fisherignore /"
    echo "                        .univignore / .brewignore (or the auto-skip"
    echo "                        of `_*` private univ-vars)"
    echo "  --with-claude         force-on claude doc review this run (overrides config)"
    echo "  --suppress-claude     force-off claude this run (overrides config)"
    echo "  --no-branch-switch    skip the framework update at the start (stay on current branch)"
end

function _wrangle_help_update
    echo "Usage: wrangle update"
    echo ""
    echo "Fetch origin and merge origin/main into the current machine-branch."
    echo "Single edge — no chain, no cascade. If origin/main is already in the"
    echo "current branch, prints \"up to date\" and exits 0."
    echo ""
    echo "On merge conflict: stops, prints what to resolve. Resolve manually"
    echo "(`git add` + `git commit`), then re-run `wrangle update`."
end

function _wrangle_help_merge
    echo "Usage: wrangle merge <branch> [-f|--force]"
    echo ""
    echo "Per-item adoption of personal-layer content from another machine-branch."
    echo "Walks dotfiles + Brewfile + fish_plugins + univ-vars, comparing the"
    echo "source branch's tracked state against the current branch's tracked"
    echo "state. For each item present in <branch> that the current branch"
    echo "doesn't have (or has with different contents), prompts what to do."
    echo ""
    echo "Prompts for new items: [a]dopt / skip [f]orever / [s]kip / [q]uit."
    echo "  `skip [f]orever` appends the item to .merge-skip; future merges"
    echo "  silently skip it. Bypass with --force."
    echo ""
    echo "Add-only by default: items YOU have that <branch> doesn't are left"
    echo "alone. Items matching the current branch's .ignore files are skipped"
    echo "with a one-line note. Framework files (scripts/, README.md, etc.) are"
    echo "never touched — those flow via PR → main → `wrangle update`."
    echo ""
    echo "Source resolves to origin/<branch> if it exists; otherwise local."
    echo ""
    echo "Options:"
    echo "  -f, --force    bypass .merge-skip (re-prompt items previously marked skip [f]orever)"
end

function _wrangle_help_push
    echo "Usage: wrangle push"
    echo ""
    echo "Push the current branch to origin. Shows a brief preview of the unpushed"
    echo "commits and their diffstat first, then pushes (no y/N prompt — typing"
    echo "the subcommand IS the decision). Use this when the shell-start unpushed"
    echo "nag fires, or after declining `[N]o` to the push prompt in `wrangle sync`."
    echo ""
    echo "If the branch has no upstream yet, git's first push will prompt with the"
    echo "usual `git push --set-upstream origin <branch>` suggestion."
end

function _wrangle_help_review_docs
    echo "Usage: wrangle review-docs"
    echo ""
    echo "Skip drift detection entirely; invoke claude to review the repo's docs"
    echo "against the current state and recent commits. Useful after a flurry of"
    echo "changes when wrangle's per-run doc-sync didn't catch up."
    echo ""
    echo "Requires the claude CLI on PATH. Ignores the wrangle.claude opt-in setting"
    echo "(if you ran this subcommand, you opted in for this run)."
end

function _wrangle_help_status
    echo "Usage: wrangle status"
    echo ""
    echo "Read-only summary of where this clone stands. Fetches origin first so"
    echo "every section reflects remote truth, then reports:"
    echo ""
    echo "  - Update status: whether this branch is ahead of or behind its own"
    echo "    remote (i.e. what `wrangle push` or `git pull` would do)."
    echo "  - Framework update: commits on origin/main not yet merged into this"
    echo "    machine-branch (i.e. what `wrangle update` would do)."
    echo "  - Peer machine-branches: every other origin/<branch> and when it was"
    echo "    last updated (i.e. candidates for `wrangle merge <branch>`)."
    echo "  - Local drift: untracked or changed state across all domains,"
    echo "    reported without committing or pushing."
    echo ""
    echo "Mutates nothing locally. The fetch updates origin/* refs but not your"
    echo "machine-branch."
end

function _wrangle_help_repair
    echo "Usage: wrangle repair [--dry-run]"
    echo ""
    echo "Recover a machine whose home/ package will not stow."
    echo ""
    echo "home/ is a single stow package, so one path stow cannot store blocks"
    echo "every file in it. When that happens `wrangle sync` stops at the re-stow"
    echo "pass on every run, and any dotfile moved into the repo before the"
    echo "breakage sits there with no symlink back into ~. sync cannot fix that,"
    echo "because sync refuses to start."
    echo ""
    echo "Three phases:"
    echo ""
    echo "  1. Unstowable paths: everything under home/ that stow will not store"
    echo "     — symlinks to absolute paths, symlinks pointing outside the tree,"
    echo "     and sockets, pipes or device files. Each can be moved back to ~."
    echo "  2. Re-stow: with the package unblocked, this links back every path"
    echo "     that was moved into home/ but never symlinked."
    echo "  3. Dangling symlinks: links in ~ pointing at paths no longer in home/."
    echo ""
    echo "Never deletes anything from ~. Paths moved back out of home/ leave the"
    echo "repo dirty on purpose — run `wrangle sync` to review and commit that."
    echo ""
    echo "  --dry-run    report all three phases without prompting or writing"
end

# Dispatch help if requested.
if test "$_subcmd" = help
    if test (count $argv) -eq 0
        _wrangle_help_top
    else
        switch $argv[1]
            case sync;                  _wrangle_help_sync
            case update;                _wrangle_help_update
            case merge;                 _wrangle_help_merge
            case push;                  _wrangle_help_push
            case review-docs;           _wrangle_help_review_docs
            case status;                _wrangle_help_status
            case repair;                _wrangle_help_repair
            case '*'
                echo "wrangle: unknown subcommand: $argv[1]" >&2
                exit 2
        end
    end
    exit 0
end

if set -q _flag_help
    switch $_subcmd
        case sync;                  _wrangle_help_sync
        case update;                _wrangle_help_update
        case merge;                 _wrangle_help_merge
        case push;                  _wrangle_help_push
        case review-docs;           _wrangle_help_review_docs
        case status;                _wrangle_help_status
        case repair;                _wrangle_help_repair
    end
    exit 0
end

if test "$_subcmd" = sync
    if set -q _flag_with_claude; and set -q _flag_suppress_claude
        echo "$GLYPH_ERR --with-claude and --suppress-claude are mutually exclusive." >&2
        exit 2
    end
end

set -g _dry_run no
set -g _force no
set -g _verbose no
set -q _flag_dry_run; and set -g _dry_run yes
set -q _flag_force; and set -g _force yes
set -q _flag_verbose; and set -g _verbose yes

set -l script_dir (dirname (realpath (status -f)))
set -g repo (git -C $script_dir rev-parse --show-toplevel 2>/dev/null)
if test -z "$repo"
    echo "$GLYPH_ERR wrangle must live inside a git repo (couldn't resolve from $script_dir)."
    exit 1
end
set -g home_subdir $repo/home
set -g ignore_file $repo/.dotignore
set -g brew_ignore_file $repo/.brewignore
set -l changelog_file $repo/.wrangle-changelog
set -l cache_dir ~/.cache/dotfiles
set -l last_run_stamp $cache_dir/last-wrangle
set -l config_file $cache_dir/wrangle-config

mkdir -p $cache_dir

# Detect first run (no last-wrangle timestamp yet on this machine).
set -g _first_run no
if not test -f $last_run_stamp
    set -g _first_run yes
end

# ─── Helper library sourcing ─────────────────────────────────────────────
# Extracted units live in their own scripts/_*.fish files so the tests can
# source them directly. Sourced here, before anything that uses them.
# These only DEFINE functions — nothing runs at source time — so sourcing
# ahead of the palette below is safe; the bodies resolve at call time.
source $repo/scripts/_skiplist.fish      # .dotignore / .fisherignore parser + skiplist match
source $repo/scripts/_univ_parse.fish    # exported-univ-vars.fish parser
source $repo/scripts/_univ_helpers.fish  # _univ_prefix for capture sub-pass grouping
source $repo/scripts/_commit_msg.fish    # commit-message builder (plain path)
source $repo/scripts/_drift.fish         # _wrangle_detect_drift — Passes 5-8
source $repo/scripts/_nag_state.fish     # pull-nag state file format + path
source $repo/scripts/_stow_guard.fish    # unstowable-path detection + stow runner

# Return the configured machine-branch for this clone, defaulting to `personal`.
# Inlined (used to live in scripts/_chain.fish, but that file's other helpers
# went away with the parent-chain model).
function _wrangle_machine_branch --argument-names repo_path
    set -l mb (git -C $repo_path config wrangle.machine-branch 2>/dev/null)
    test -z "$mb"; and set mb personal
    echo $mb
end

# Record that origin/main was successfully merged so the shell-start pull
# nag stops re-firing until origin/main next moves. The file's format and
# location belong to scripts/_nag_state.fish, which the shell integration
# sources too — this used to be hardcoded on both sides.
function _wrangle_record_main_nag --argument-names repo_path
    # `--verify` is load-bearing: without it, `git rev-parse origin/missing`
    # echoes the literal ref to stdout (exit 128) and we'd write a bogus SHA.
    set -l sha (git -C $repo_path rev-parse --verify origin/main 2>/dev/null)
    _wrangle_nag_state_write $sha
end

# ─── Color + spinner library ─────────────────────────────────────────────
# Three-color visual hierarchy:
#   - Section headers (Pass titles, _header): bright magenta bold + heavy
#     ━━━ rules. Loudest — owns the page, scans as "new orientation point."
#   - Subheaders (per-item, _subheader): indented 2sp, cyan + light ───
#     rules. Visually nested under the parent section.
#   - File paths / branch names (_name): cyan, no bold. Mid-weight body
#     accent — same idiom git uses for paths.
#   - Input keys (_key, applied via _keys to bracketed letters): bright
#     yellow bold. Pops as "your turn to act."
# Other colors stay role-based: green=success, red=error, yellow=warning,
# brblack=dim. Box-drawing characters over emoji per house style. Colors
# degrade to noops on non-color terminals (fish's set_color handles that).
function _h     ; set_color --bold; end           # generic bold (used by _n)
function _ok    ; set_color brgreen --bold; end   # ✔ success
function _err   ; set_color brred --bold; end     # ✘ error
function _warn  ; set_color bryellow --bold; end  # ⚠ warning
function _dim   ; set_color brblack; end          # · neutral / hint
function _info  ; set_color cyan; end             # paths, branch names
function _lead  ; set_color brcyan --bold; end    # ▸ in-body leader callout
function _hdr   ; set_color brmagenta --bold; end # section header title
function _sub   ; set_color cyan; end             # subheader title
function _key   ; set_color bryellow --bold; end  # [t] [i] etc. in prompts
function _rs    ; set_color normal; end           # reset

# Glyph globals: include color + character + reset so we can drop them into
# existing format strings without restructuring everything. Heavy unicode
# variants (✔ ✘) over light (✓ ✗) for more presence at normal terminal
# weight — they need to draw the eye without emoji.
set -g GLYPH_OK    (_ok)"✔"(_rs)
set -g GLYPH_ERR   (_err)"✘"(_rs)
set -g GLYPH_WARN  (_warn)"⚠"(_rs)
set -g GLYPH_DIM   (_dim)"·"(_rs)                # separator / dim status
set -g GLYPH_LEAD  (_lead)"▸"(_rs)               # in-body leader (calls eye)
set -g GLYPH_ARROW (_dim)"→"(_rs)
set -g HEAD_RULE   (_dim)"━━━"(_rs)
set -g SUB_RULE    (_dim)"───"(_rs)

# Print a section header: dim ━━━ rules flanking a bright-magenta-bold title.
# Standardizes every pass's header so headers look identical across the script.
function _header
    echo "$HEAD_RULE "(_hdr)"$argv"(_rs)" $HEAD_RULE"
end

# Print a subheader nested under a section: 2sp indent, dim ─── rules,
# cyan title. Used by _show (per-file blocks during drift) so each item
# clearly sits inside its parent section.
function _subheader
    echo "  $SUB_RULE "(_sub)"$argv"(_rs)" $SUB_RULE"
end

# Colorize bracketed key letters in a prompt template. Replaces every `[x]`
# (where x is one or more chars) with a bright-yellow-bold version, leaving
# surrounding text default-colored. Use as: read -P (_keys "  [t]rack / …")
function _keys --argument-names text
    set -l o (_key)
    set -l z (_rs)
    # Single-quote the [$1] middle so fish doesn't try to index $o or expand $1.
    set -l repl $o'[$1]'$z
    string replace -ra '\[([^]]+)\]' $repl -- $text
end

# Format a count for inline display: bold for non-zero (signal), dim for
# zero (visual fade so the eye skips it). Used in summary lines and
# "Found N untracked" callouts.
function _n
    if test "$argv[1]" = "0"
        printf '%s0%s' (_dim) (_rs)
    else
        printf '%s%s%s' (_h) "$argv[1]" (_rs)
    end
end

# Format an item name (file path, plugin name, var name) for emphasis in
# drift listings — cyan to set it apart from surrounding prose.
function _name
    printf '%s%s%s' (_info) "$argv[1]" (_rs)
end

# Spinner: shows braille animation on a single line until _spinner_stop fires.
# Skipped if stderr isn't a TTY (no point repainting, and CI captures choke
# on the \r overwrites). NB: `status is-interactive` returns false inside a
# script even when invoked from an interactive shell — use `test -t 2` to
# detect a writable terminal directly. The original `is-interactive` check
# made every spinner since v1.5.0 silently no-op.
function _spinner_start --argument-names label
    test -t 2; or return
    set -gx _SPINNER_LABEL $label
    # --no-config: this subshell only needs printf + sleep. Sourcing config.fish
    # would re-run fnm/plugin init in a backgrounded subprocess where fnm's
    # shell-detection fails ("Can't infer shell!") and leaks to stderr.
    fish --no-config -c '
        set chars ⣾ ⣽ ⣻ ⢿ ⡿ ⣟ ⣯ ⣷
        set i 1
        while true
            printf "\r  \033[36m%s\033[0m %s " "$chars[$i]" "$_SPINNER_LABEL" >&2
            set i (math "($i % 8) + 1")
            sleep 0.1
        end
    ' &
    set -g _spinner_pid $last_pid
end

function _spinner_stop
    if set -q _spinner_pid
        kill $_spinner_pid 2>/dev/null
        wait $_spinner_pid 2>/dev/null
        printf "\r\033[K" >&2     # CR + erase-to-end-of-line
        set -e _spinner_pid
        set -e _SPINNER_LABEL
    end
end

# Run a command with a spinner showing $label, swallow stdout into a temp
# file, on success: re-emit the captured output; on failure: print it under
# a warning. Returns the wrapped command's exit status. Stderr passes through
# live so things like sudo password prompts still work.
#
# Usage:  _with_spinner "doing thing…" the_command arg1 arg2
function _with_spinner --argument-names label
    set -l cmd $argv[2..-1]
    _spinner_start "$label"
    set -l out (mktemp)
    $cmd > $out
    set -l rv $status
    _spinner_stop
    if test -s $out
        cat $out
    end
    rm -f $out
    return $rv
end

# Same as _with_spinner but captures BOTH stdout and stderr. Use when the
# wrapped command streams progress to stderr (e.g. `git push`, which writes
# "Counting objects: …" / "Compressing: …" to stderr); without capturing
# stderr, that stream fights the spinner for the same terminal line and
# strands ghost spinner frames between the streamed lines.
#
# Trade-off: if the command needs to prompt (HTTPS credentials, ssh passphrase),
# the prompt is captured and invisible — caller must guarantee non-interactive.
#
# Usage:  _with_spinner_quiet "doing thing…" the_command arg1 arg2
function _with_spinner_quiet --argument-names label
    set -l cmd $argv[2..-1]
    _spinner_start "$label"
    set -l out (mktemp)
    $cmd > $out 2>&1
    set -l rv $status
    _spinner_stop
    if test -s $out
        cat $out
    end
    rm -f $out
    return $rv
end

# ─── Early-exit subcommand handlers ──────────────────────────────────────
# Each subcommand below (update, merge, push, review-docs) handles its
# work and exits, never falling through to the sync pipeline.

# Accumulators for the run summary.
set -g _changes
function _log_change --inherit-variable _changes
    set -g _changes $_changes $argv[1]
end

# Report tracked-file modifications that didn't surface through this pass's
# drift checks — e.g. a `fisher install` outside wrangle updates fish_plugins
# alongside the install, so installed-vs-file matches (no drift) but the FILE
# is dirty in git. Each drift pass calls this with its domain files so the
# user sees the external edit AND `_changes` gets an entry (so doc-sync runs).
#
# Usage: _report_external_changes "description" path1 [path2 ...]
function _report_external_changes --inherit-variable repo
    set -l description $argv[1]
    set -l files $argv[2..-1]
    set -l dirty
    for f in $files
        if test -n "$(git -C $repo status --porcelain -- $f 2>/dev/null | string trim)"
            set -a dirty $f
        end
    end
    test (count $dirty) -eq 0; and return
    echo "  $GLYPH_LEAD $description"
    git -C $repo diff --stat --color=always -- $dirty 2>/dev/null | sed 's/^/    /'
    _log_change "$description"
end

# Run-abort helper. [q] in any prompt and Ctrl-C both route through here so
# the entire run exits cleanly — previously [q] only broke the current pass
# and fell through to the next one, and Ctrl-C was swallowed by `read` and
# matched the empty-string skip case. Tracked files already moved into home/
# and .univexport/.univignore edits stay on disk; re-run wrangle to commit.
function _wrangle_abort --argument-names reason exit_code
    test -z "$exit_code"; and set exit_code 0
    _spinner_stop   # clear any half-rendered spinner before our message
    echo ""
    echo "  $GLYPH_DIM $reason — exiting without committing or pushing. Re-run wrangle to commit any tracked changes."
    exit $exit_code
end
function _wrangle_on_sigint --on-signal SIGINT
    _wrangle_abort interrupted 130
end

# Claude invocation helper. Single source of truth for model/effort/session-id
# defaults and the claude CLI flags. Streams text output so the user sees
# progress in real time. Each invocation gets a fresh session (no
# `--session-id`), matching `_build_commit_msg_via_claude`'s stateless
# pattern. Persistent sessions were a premature optimization — the
# doc-review prompt is self-contained per run — and they failed
# intermittently when a prior wrangle invocation was interrupted and left
# the session locked server-side ("Session ID … is already in use").
function _wrangle_invoke_claude
    set -l model sonnet
    set -l effort low
    test -n "$WRANGLE_CLAUDE_MODEL"; and set model "$WRANGLE_CLAUDE_MODEL"
    test -n "$WRANGLE_CLAUDE_EFFORT"; and set effort "$WRANGLE_CLAUDE_EFFORT"

    echo "  $GLYPH_DIM model=$model · effort=$effort"
    echo ""

    # Spinner runs for the full claude duration. The streamed output appears
    # below the spinner line as it arrives; not pretty but cheap and
    # unambiguous ("something is happening"). Stopping the spinner on first-
    # byte requires piping through fish in a way that loses exit status.
    # --permission-mode acceptEdits: auto-approve Edit/Write on the .md files
    # claude is asked to maintain.
    # --allowedTools: explicit whitelist so claude doesn't waste a turn (and
    # noisy output) trying Bash/WebFetch/etc. only to hit the no-TTY wall.
    # Doc review needs to read files, grep for references, and edit/create
    # markdown — nothing else.
    _spinner_start "claude thinking… (model=$model effort=$effort)"
    claude -p --output-format text --permission-mode acceptEdits \
        --allowedTools "Read,Edit,Write,Grep,Glob" \
        --model $model --effort $effort "$argv[1]"
    set -l rv $status
    _spinner_stop
    return $rv
end

# ─── Framework-update helper ─────────────────────────────────────────────
# Fetches origin and merges origin/main into the current machine-branch.
# Single edge (no chain). On merge conflict, bails with instructions —
# user resolves manually, then re-runs `wrangle update`. Used by both the
# `update` subcommand handler and Pass 1 of the sync pipeline.
#
# Returns: 0 on success (whether or not there were commits to merge),
#          1 on merge conflict.
function _wrangle_update --inherit-variable repo
    pushd $repo >/dev/null

    _with_spinner "Fetching origin…" git fetch origin --prune 2>/dev/null

    set -l current (git rev-parse --abbrev-ref HEAD)

    # Verify origin/main exists (a brand-new clone with no remote main is rare
    # but should not crash).
    if not git rev-parse --verify --quiet origin/main >/dev/null
        echo "  $GLYPH_DIM no origin/main; nothing to update from"
        popd >/dev/null
        return 0
    end

    set -l ahead (git rev-list --count "$current..origin/main" 2>/dev/null)
    test -z "$ahead"; and set ahead 0

    if test "$ahead" -eq 0
        echo "  $GLYPH_OK "(_name $current)" already up to date with "(_name origin/main)
        popd >/dev/null
        return 0
    end

    _spinner_start "Merging "(_name origin/main)" into "(_name $current)" ($ahead commit(s))…"
    git merge --no-ff origin/main -m "merge origin/main into $current (wrangle update)" 2>&1
    set -l merge_rv $status
    _spinner_stop

    if test $merge_rv -ne 0
        echo ""
        echo "  $GLYPH_WARN merge conflict: "(_name origin/main)" → "(_name $current)
        echo "    Files needing resolution:"
        git diff --name-only --diff-filter=U | sed 's|^|      |'
        echo ""
        echo "  Resolve, then:"
        echo "    git add <files> && git commit"
        echo "    wrangle update     # re-run; will be a no-op if you committed the merge"
        popd >/dev/null
        return 1
    end

    echo "  $GLYPH_OK merged "(_n $ahead)" commit(s) from "(_name origin/main)" into "(_name $current)
    _wrangle_record_main_nag $repo

    popd >/dev/null
    return 0
end

# Run the push step. Mode: 'prompt' (sync style — show preview + y/N/d loop)
# or 'immediate' (push subcommand style — preview, then push without asking).
# Returns the git push exit status (or 0 if nothing to push).
function _wrangle_do_push --inherit-variable repo --argument-names mode
    pushd $repo >/dev/null
    set -l remote (git remote | head -1)
    if test -z "$remote"
        echo "  $GLYPH_DIM no remote configured; nothing to push"
        popd >/dev/null
        return 0
    end

    set -l branch (git rev-parse --abbrev-ref HEAD)
    set -l upstream_exists no
    git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; and set upstream_exists yes

    set -l unpushed 0
    if test $upstream_exists = yes
        set unpushed (git rev-list --count '@{u}..HEAD' 2>/dev/null)
    else
        set unpushed (git rev-list --count HEAD 2>/dev/null)
    end

    if test $unpushed -eq 0
        echo "  $GLYPH_OK already up to date with $remote/$branch"
        popd >/dev/null
        return 0
    end

    # Preview block (same for both modes).
    if test $upstream_exists = yes
        echo "  "(_n $unpushed)" commit(s) ahead of "(_name "$remote/$branch")":"
        git --no-pager log --color=always --pretty='    %C(yellow)%h%Creset %s' '@{u}..HEAD'
        echo ""
        echo "  Changed files:"
        git --no-pager diff --stat --color=always '@{u}..HEAD' | sed 's/^/    /'
    else
        echo "  Branch "(_name $branch)" has no upstream yet — first push will set it on "(_name $remote)"."
        echo "  Last commit:"
        git --no-pager log -1 --color=always --pretty='    %C(yellow)%h%Creset %s'
    end

    if test "$mode" = immediate
        # Push without prompting — user typed the subcommand, that IS the decision.
        echo ""
        _with_spinner_quiet "Pushing to $remote…" git push
        set -l push_rv $status
        if test $push_rv -eq 0
            echo "  $GLYPH_OK pushed"
        else
            echo "  $GLYPH_WARN push failed"
        end
        popd >/dev/null
        return $push_rv
    end

    # Prompt mode (sync's Pass 12). Loop on [d]iff, return on y/n.
    while true
        echo ""
        read -P (_keys "  Push to $remote? [y]es / [N]o / [d]iff (full) > ") push_choice
        switch $push_choice
            case d D diff
                if test $upstream_exists = yes
                    git --no-pager diff --color=always '@{u}..HEAD' | less -R
                else
                    git log -p --color=always | less -R
                end
                # loop back to re-prompt
            case y Y yes
                _with_spinner_quiet "Pushing to $remote…" git push
                set -l push_rv $status
                if test $push_rv -eq 0
                    echo "  $GLYPH_OK pushed"
                else
                    echo "  $GLYPH_WARN push failed"
                end
                popd >/dev/null
                return $push_rv
            case n N no ''
                echo "  $GLYPH_DIM skipped"
                popd >/dev/null
                return 0
            case '*'
                echo "  ? '$push_choice' — y / n / d"
        end
    end
end

# ─── update ──────────────────────────────────────────────────────────────
# `wrangle update` — fetch + merge origin/main into current machine-branch, exit.
if test "$_subcmd" = update
    _header "Framework update"
    _wrangle_update
    exit $status
end

# ─── merge ───────────────────────────────────────────────────────────────
# `wrangle merge <branch>` — per-item content adoption from another
# machine-branch into the current one. Walks dotfiles + Brewfile +
# fish_plugins + univ-vars, comparing source's tracked state vs current's.
# Add-only by default. Honors current's .ignore files. Framework files are
# never touched (those flow via PR → main → `wrangle update`).
if test "$_subcmd" = merge
    if test (count $argv) -ne 1
        echo "$GLYPH_ERR merge expects exactly one argument (the source branch name)" >&2
        echo "  usage: wrangle merge <branch>" >&2
        exit 2
    end
    set -l src_arg $argv[1]

    pushd $repo >/dev/null

    set -l current (git rev-parse --abbrev-ref HEAD)
    if test "$src_arg" = "$current"
        echo "$GLYPH_ERR can't merge "(_name $current)" into itself" >&2
        popd >/dev/null
        exit 2
    end
    if test "$src_arg" = main
        echo "$GLYPH_ERR main is the framework branch — use "(_name "wrangle update")" instead" >&2
        popd >/dev/null
        exit 2
    end

    # Resolve source: prefer origin/<branch>, fall back to local <branch>.
    set -l source
    if git rev-parse --verify --quiet origin/$src_arg >/dev/null
        set source origin/$src_arg
    else if git rev-parse --verify --quiet refs/heads/$src_arg >/dev/null
        set source $src_arg
    else
        echo "$GLYPH_ERR no branch '$src_arg' on origin or locally" >&2
        popd >/dev/null
        exit 1
    end

    _header "Merge from $source"
    echo "  $GLYPH_DIM source: "(_name $source)" → current: "(_name $current)
    echo ""

    # Load current branch's ignore lists (skiplist module exposes the loader).
    set -l dot_ignores
    test -f $repo/.dotignore;     and set dot_ignores     (_wrangle_load_dotignore $repo/.dotignore)
    set -l brew_ignores
    test -f $repo/.brewignore;    and set brew_ignores    (_wrangle_load_dotignore $repo/.brewignore)
    set -l fisher_ignores
    test -f $repo/.fisherignore;  and set fisher_ignores  (_wrangle_load_dotignore $repo/.fisherignore)
    set -l univ_ignores
    test -f $repo/.univignore;    and set univ_ignores    (_wrangle_load_dotignore $repo/.univignore)

    # Load .merge-skip (merge-only skip list, populated by the [f]orever
    # prompt action). --force bypasses it for the duration of this run.
    set -l merge_skip_entries
    if test "$_force" = no; and test -f $repo/.merge-skip
        set merge_skip_entries (_wrangle_load_dotignore $repo/.merge-skip)
    end

    # Matcher for .merge-skip entries. Each entry is "<domain> <item>" split
    # on the first space (so items containing spaces — e.g. `brew "Some App"`
    # — survive intact). Returns 0 if (domain, item) is listed; 1 otherwise.
    function _merge_is_skipped
        set -l d $argv[1]
        set -l i $argv[2]
        set -l entries $argv[3..-1]
        for e in $entries
            set -l parts (string split -m 1 ' ' -- $e)
            test (count $parts) -eq 2; or continue
            test "$parts[1]" = "$d"; and test "$parts[2]" = "$i"; and return 0
        end
        return 1
    end

    # Reset counters used in summary.
    set -g _merge_dot_adopted 0
    set -g _merge_brew_adopted 0
    set -g _merge_fisher_adopted 0
    set -g _merge_univ_adopted 0
    set -g _merge_need_restow no

    # ── Domain 1: dotfiles ──────────────────────────────────────────────
    _subheader "Dotfiles"
    # Skip:
    #   - .gitkeep (placeholder for empty tracked dirs)
    #   - home/.config/fish/fish_plugins (own domain — fisher prompt below handles it)
    #   - home/.config/fish/exported-univ-vars.fish (own domain — univ-var prompt below)
    #   - home/.config/fish/conf.d/wrangle_integration.fish (framework — flows via
    #     `wrangle update`, not `wrangle merge`)
    set -l src_dotfiles (git ls-tree -r $source --name-only -- home/ 2>/dev/null \
        | grep -vE '/\.gitkeep$|^home/\.config/fish/fish_plugins$|^home/\.config/fish/exported-univ-vars\.fish$|^home/\.config/fish/conf\.d/wrangle_integration\.fish$')
    set -l dot_total 0
    for path in $src_dotfiles
        set -l rel (string replace -- 'home/' '' $path)
        # Honor .dotignore (the loader's match helper does substring/glob).
        if _wrangle_is_skipped $rel $dot_ignores
            echo "    $GLYPH_DIM skipping "(_name $rel)" (matches .dotignore)"
            continue
        end
        # Honor .merge-skip (merge-only sticky skips). Only existence is
        # tracked; content conflicts re-prompt every run by design.
        if _merge_is_skipped dotfile $path $merge_skip_entries
            echo "    $GLYPH_DIM skipping "(_name $path)" (matches .merge-skip)"
            continue
        end

        set -l src_blob (git show $source:$path 2>/dev/null | string collect)
        set -l current_blob
        if test -f $repo/$path
            set current_blob (cat $repo/$path | string collect)
        end

        if test -z "$current_blob"
            # New file: prompt to adopt, skip once, or skip forever.
            echo ""
            echo "    "(_name $path)" (new from source)"
            while true
                read -P (_keys "    [a]dopt / skip [f]orever / [s]kip / [q]uit > ") choice
                switch $choice
                    case a A adopt
                        mkdir -p (dirname $repo/$path)
                        printf '%s' "$src_blob" > $repo/$path
                        set _merge_dot_adopted (math $_merge_dot_adopted + 1)
                        set _merge_need_restow yes
                        _log_change "adopted dotfile from $source: $rel"
                        echo "      $GLYPH_OK adopted"
                        break
                    case f F forever
                        echo "dotfile $path" >> $repo/.merge-skip
                        _log_change "skip-forever (.merge-skip): dotfile $path"
                        echo "      $GLYPH_OK added to .merge-skip"
                        break
                    case s S skip ''
                        echo "      $GLYPH_DIM skipped (will re-surface next merge)"
                        break
                    case q Q quit
                        _wrangle_abort quit
                    case '*'
                        echo "      ? '$choice' — answer a/f/s/q"
                end
            end
            set dot_total (math $dot_total + 1)
        else if test "$current_blob" != "$src_blob"
            # Conflict: prompt with 4 options.
            echo ""
            echo "    "(_name $path)" (differs from source)"
            while true
                read -P (_keys "    [a]dopt source / [k]eep mine / [d]iff / [s]kip / [q]uit > ") choice
                switch $choice
                    case a A adopt
                        printf '%s' "$src_blob" > $repo/$path
                        set _merge_dot_adopted (math $_merge_dot_adopted + 1)
                        _log_change "adopted dotfile from $source: $rel (overwrote local)"
                        echo "      $GLYPH_OK adopted source's version"
                        break
                    case k K keep
                        echo "      $GLYPH_OK kept local"
                        break
                    case d D diff
                        echo ""
                        git --no-pager diff --no-index --color=always $repo/$path (printf '%s' "$src_blob" | psub) 2>&1 \
                            | sed 's|^|      |'
                        echo ""
                        # Loop back to re-prompt.
                    case s S skip ''
                        echo "      $GLYPH_DIM skipped (will resurface next merge)"
                        break
                    case q Q quit
                        _wrangle_abort quit
                    case '*'
                        echo "      ? '$choice' — answer a/k/d/s/q"
                end
            end
            set dot_total (math $dot_total + 1)
        end
        # Identical → silent skip, doesn't increment dot_total.
    end
    if test $dot_total -eq 0
        echo "    $GLYPH_OK no dotfile drift to merge"
    end

    # ── Domain 2: Brewfile ──────────────────────────────────────────────
    echo ""
    _subheader "Brewfile"
    set -l src_brew_lines (git show $source:Brewfile 2>/dev/null | grep -vE '^\s*(#|$)')
    set -l cur_brew_lines
    test -f $repo/Brewfile; and set cur_brew_lines (grep -vE '^\s*(#|$)' $repo/Brewfile)
    set -l brew_total 0
    for line in $src_brew_lines
        contains -- $line $cur_brew_lines; and continue
        # Honor .brewignore (substring match).
        set -l brew_skipped no
        for pat in $brew_ignores
            if string match -q "*$pat*" -- $line
                echo "    $GLYPH_DIM skipping "(_name $line)" (matches .brewignore: $pat)"
                set brew_skipped yes
                break
            end
        end
        test "$brew_skipped" = yes; and continue
        # Honor .merge-skip (merge-only sticky skips).
        if _merge_is_skipped brew $line $merge_skip_entries
            echo "    $GLYPH_DIM skipping "(_name $line)" (matches .merge-skip)"
            continue
        end

        echo ""
        echo "    "(_name $line)
        while true
            read -P (_keys "    [a]dopt (append + brew install) / skip [f]orever / [s]kip / [q]uit > ") choice
            switch $choice
                case a A adopt
                    echo $line >> $repo/Brewfile
                    # Best-effort install via brew bundle install with a one-line
                    # file (psub turns the echo into a temp file path). Handles
                    # brew/cask/mas/tap/vscode/etc. without parsing line type.
                    _with_spinner "brew bundle install for $line…" brew bundle install --file=(echo $line | psub)
                    set -l install_rv $status
                    if test $install_rv -ne 0
                        echo "      $GLYPH_WARN brew bundle install failed (exit $install_rv)"
                        echo "      $GLYPH_DIM the Brewfile entry was appended; run `brew bundle install` to retry"
                    end
                    set _merge_brew_adopted (math $_merge_brew_adopted + 1)
                    _log_change "adopted brew from $source: $line"
                    echo "      $GLYPH_OK adopted"
                    break
                case f F forever
                    echo "brew $line" >> $repo/.merge-skip
                    _log_change "skip-forever (.merge-skip): brew $line"
                    echo "      $GLYPH_OK added to .merge-skip"
                    break
                case s S skip ''
                    echo "      $GLYPH_DIM skipped (will re-surface next merge)"
                    break
                case q Q quit
                    _wrangle_abort quit
                case '*'
                    echo "      ? '$choice' — answer a/f/s/q"
            end
        end
        set brew_total (math $brew_total + 1)
    end
    if test $brew_total -eq 0
        echo "    $GLYPH_OK no Brewfile drift to merge"
    end

    # ── Domain 3: fish_plugins ─────────────────────────────────────────
    echo ""
    _subheader "Fisher plugins"
    set -l src_fisher_lines (git show $source:home/.config/fish/fish_plugins 2>/dev/null | grep -vE '^\s*(#|$)')
    set -l cur_fisher_lines
    test -f $repo/home/.config/fish/fish_plugins; and set cur_fisher_lines (grep -vE '^\s*(#|$)' $repo/home/.config/fish/fish_plugins)
    set -l fisher_total 0
    for plugin in $src_fisher_lines
        contains -- $plugin $cur_fisher_lines; and continue
        if contains -- $plugin $fisher_ignores
            echo "    $GLYPH_DIM skipping "(_name $plugin)" (matches .fisherignore)"
            continue
        end
        if _merge_is_skipped fisher $plugin $merge_skip_entries
            echo "    $GLYPH_DIM skipping "(_name $plugin)" (matches .merge-skip)"
            continue
        end

        echo ""
        echo "    "(_name $plugin)
        while true
            read -P (_keys "    [a]dopt (append + fisher install) / skip [f]orever / [s]kip / [q]uit > ") choice
            switch $choice
                case a A adopt
                    echo $plugin >> $repo/home/.config/fish/fish_plugins
                    if functions -q fisher
                        _with_spinner "fisher install $plugin…" fish -c "fisher install $plugin"
                    end
                    set _merge_fisher_adopted (math $_merge_fisher_adopted + 1)
                    _log_change "adopted fisher plugin from $source: $plugin"
                    echo "      $GLYPH_OK adopted"
                    break
                case f F forever
                    echo "fisher $plugin" >> $repo/.merge-skip
                    _log_change "skip-forever (.merge-skip): fisher $plugin"
                    echo "      $GLYPH_OK added to .merge-skip"
                    break
                case s S skip ''
                    echo "      $GLYPH_DIM skipped (will re-surface next merge)"
                    break
                case q Q quit
                    _wrangle_abort quit
                case '*'
                    echo "      ? '$choice' — answer a/f/s/q"
            end
        end
        set fisher_total (math $fisher_total + 1)
    end
    if test $fisher_total -eq 0
        echo "    $GLYPH_OK no fisher_plugins drift to merge"
    end

    # ── Domain 4: univ-var patterns ────────────────────────────────────
    echo ""
    _subheader "Univ-var patterns"
    set -l src_univ_patterns (git show $source:.univexport 2>/dev/null | grep -vE '^\s*(#|$)')
    set -l cur_univ_patterns
    test -f $repo/.univexport; and set cur_univ_patterns (grep -vE '^\s*(#|$)' $repo/.univexport)
    set -l univ_total 0
    for pat in $src_univ_patterns
        contains -- $pat $cur_univ_patterns; and continue
        # Honor .univignore (treat as patterns; substring + glob via string match).
        set -l univ_skipped no
        for ipat in $univ_ignores
            if string match -q $ipat $pat
                echo "    $GLYPH_DIM skipping "(_name $pat)" (matches .univignore: $ipat)"
                set univ_skipped yes
                break
            end
        end
        test "$univ_skipped" = yes; and continue
        # Honor .merge-skip (merge-only sticky skips).
        if _merge_is_skipped univ $pat $merge_skip_entries
            echo "    $GLYPH_DIM skipping "(_name $pat)" (matches .merge-skip)"
            continue
        end

        echo ""
        echo "    "(_name $pat)" (new pattern from source)"
        while true
            read -P (_keys "    [a]dopt (append + apply matching vars) / skip [f]orever / [s]kip / [q]uit > ") choice
            switch $choice
                case a A adopt
                    echo $pat >> $repo/.univexport
                    # Apply matching vars from source's exported file into live shell.
                    set -l src_export_file_tmp (mktemp)
                    git show $source:home/.config/fish/exported-univ-vars.fish > $src_export_file_tmp 2>/dev/null
                    if test -s $src_export_file_tmp
                        set -l names (_wrangle_univ_parse_names $src_export_file_tmp)
                        for name in $names
                            if string match -q $pat $name
                                set -l vals (_wrangle_univ_parse_values $src_export_file_tmp $name)
                                test (count $vals) -eq 0; and continue
                                set -U --erase $name 2>/dev/null
                                set -U $name $vals
                            end
                        end
                    end
                    rm -f $src_export_file_tmp
                    set _merge_univ_adopted (math $_merge_univ_adopted + 1)
                    _log_change "adopted univ-var pattern from $source: $pat"
                    echo "      $GLYPH_OK adopted"
                    break
                case f F forever
                    echo "univ $pat" >> $repo/.merge-skip
                    _log_change "skip-forever (.merge-skip): univ $pat"
                    echo "      $GLYPH_OK added to .merge-skip"
                    break
                case s S skip ''
                    echo "      $GLYPH_DIM skipped (will re-surface next merge)"
                    break
                case q Q quit
                    _wrangle_abort quit
                case '*'
                    echo "      ? '$choice' — answer a/f/s/q"
            end
        end
        set univ_total (math $univ_total + 1)
    end
    if test $univ_total -eq 0
        echo "    $GLYPH_OK no univ-var pattern drift to merge"
    end

    # ── Post-merge: re-stow if any new dotfiles, regenerate univ-vars file if changed ──
    if test "$_merge_need_restow" = yes; and command -q stow
        echo ""
        # The status used to be discarded entirely, and the merge went on to
        # git add -A and commit — so a failed stow was invisible and the
        # adopted dotfiles were committed without ever being linked into ~.
        #
        # Unlike the track path, nothing here came out of ~: the adopted files
        # arrived from the source branch. The repo state is legitimate and
        # worth committing, so this reports and continues rather than aborting.
        _wrangle_stow_run "Re-stowing home/ into ~…" $repo
        or begin
            echo ""
            echo "$GLYPH_ERR STOW REFUSED — the adopted files are NOT linked into ~:"
            _wrangle_stow_explain_failure "    " $_wrangle_stow_err
            echo ""
            echo "  The merge itself is fine and will still be committed — the files"
            echo "  are in "(_name home/)", they just have no symlinks in ~ yet."
            echo "  Run "(_name "wrangle repair")" to fix the package, then "(_name "wrangle sync")"."
            echo ""
        end
    end

    if test $_merge_univ_adopted -gt 0
        # Regenerate this branch's exported-univ-vars.fish with the new tracked patterns.
        set -l univ_export_file $repo/.univexport
        set -l univ_output_file $repo/home/.config/fish/exported-univ-vars.fish
        _univ_regenerate
    end

    # ── End: commit if anything was adopted ────────────────────────────
    set -l total (math $_merge_dot_adopted + $_merge_brew_adopted + $_merge_fisher_adopted + $_merge_univ_adopted)
    echo ""
    if test $total -eq 0
        echo "  $GLYPH_OK no adoptions from $source — nothing to commit"
        popd >/dev/null
        exit 0
    end

    _header "Commit"
    git add -A

    if test -z "$WRANGLE_ALLOW_SECRETS"
        _spinner_start "Scanning staged diff for secrets…"
        set -l secret_hits (git diff --cached | $repo/scripts/scan-secrets)
        _spinner_stop
        if test (count $secret_hits) -gt 0
            echo ""
            echo "$GLYPH_ERR SECRET-LIKE PATTERNS in staged diff — refusing to commit:"
            for h in $secret_hits
                echo "    $h"
            end
            echo ""
            echo "Resolve the offending content, or bypass with WRANGLE_ALLOW_SECRETS=1 and re-run."
            popd >/dev/null
            exit 1
        end
    end

    set -l commit_msg "wrangle: merge from $source: $_merge_dot_adopted dotfile(s), $_merge_brew_adopted brew(s), $_merge_fisher_adopted fisher plugin(s), $_merge_univ_adopted univ-var pattern(s)"
    _with_spinner "Committing…" git commit -m "$commit_msg"
    echo "  $GLYPH_OK committed: $commit_msg"

    popd >/dev/null
    exit 0
end

# ─── push ────────────────────────────────────────────────────────────────
# `wrangle push` — push current branch to origin (preview, no prompt), exit.
if test "$_subcmd" = push
    _header "Push"
    _wrangle_do_push immediate
    exit $status
end

# ─── review-docs ─────────────────────────────────────────────────────────
# `wrangle review-docs` — skip drift entirely, invoke claude on current state.
# Useful when you opted into claude AFTER making changes (so the normal sync
# doc-sync path skipped because $_changes was empty), or when you've hand-
# edited docs and want a sanity check. Runs only the claude pass with recent
# commit log as context.
if test "$_subcmd" = review-docs
    if not command -q claude
        echo "$GLYPH_ERR review-docs requires the claude CLI." >&2
        exit 1
    end
    _header "Doc review"
    echo "  Asking claude to review docs against recent repo state..."

    set -l prompt_text "You are claude-code invoked by `wrangle review-docs` at $repo. The user has explicitly asked you to review the repo's documentation against the current state of the repo and recent activity. There are no specific changes from a wrangle run this time — your job is to look at the recent commits and current docs and propose updates if anything is factually wrong, out of date, or incomplete.

The repo has two doc tiers:
  - FRAMEWORK docs describe the sync system itself: README.md and setup-new-machine.md at the repo root. They live on `main` and should stay opinion-free.
  - PERSONAL docs describe the user's specific layer: post-bootstrap manual steps, tool-specific auth, machine-specific setup notes. Live on the machine-branch (default: `personal`). A common convention is a top-level PERSONAL.md.

You MAY edit any .md file and create new .md files. You MUST NOT touch anything under scripts/, the Brewfile, fish_plugins, .dotignore, .brewignore, .fisherignore, .gitignore, any file under home/, or any dotfile/dotdir (including .claude/, .git/, .github/).

Only the Edit, Write, Read, Grep, and Glob tools are available to you. Don't attempt Bash, WebFetch, Task, etc. — there's no TTY to approve them and they'll fail.

Be conservative — only act on user-facing consequences.

Recent commit history (last 15 commits):
"
    for l in (git -C $repo log --oneline -15 2>/dev/null)
        set prompt_text "$prompt_text  $l
"
    end

    _wrangle_invoke_claude "$prompt_text"
    set -l rv $status
    echo ""
    if test $rv -eq 0
        echo "  $GLYPH_OK claude finished. `git status` in the repo to see any doc changes."
    else
        echo "  $GLYPH_WARN claude exited non-zero ($rv)."
    end
    exit $rv
end

# ─── status ──────────────────────────────────────────────────────────────
# `wrangle status` — read-only diagnostic. Fetches origin once so every
# section below reflects remote truth, then runs a dry-run sync to surface
# local drift. Mutates no local refs.
#
# Reports two independent comparisons, in this order:
#   Update status     origin/$current ↔ $current   → wrangle push / git pull
#   Framework update  origin/main    → $current    → wrangle update
# They answer different questions and have different remedies, so they get
# separate sections. Peer machine-branches follows, then the drift dry-run.
if test "$_subcmd" = status
    _header "Status"
    pushd $repo >/dev/null

    _with_spinner "Fetching origin…" git fetch origin --prune 2>/dev/null

    set -l current (git rev-parse --abbrev-ref HEAD)

    # ── Update status (this branch vs its own remote) ─────────────────
    # Ahead/behind against origin/$current alone. This is the push/pull
    # question. Whether trunk has work you haven't merged is a separate
    # question with a separate remedy — reported under Framework update
    # below. Same axes the shell-start nags report
    # (home/.config/fish/conf.d/wrangle_integration.fish).
    echo ""
    _subheader "Update status"
    if not git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1
        echo "    $GLYPH_DIM "(_name $current)" has no upstream yet — "(_name "wrangle push")" will set one."
    else
        set -l ahead (git rev-list --count '@{u}..HEAD' 2>/dev/null)
        set -l behind (git rev-list --count 'HEAD..@{u}' 2>/dev/null)
        test -z "$ahead";  and set ahead 0
        test -z "$behind"; and set behind 0
        if test "$ahead" -eq 0; and test "$behind" -eq 0
            echo "    $GLYPH_OK "(_name $current)" in sync with "(_name "origin/$current")
        end
        if test "$ahead" -gt 0
            echo "    "(_n $ahead)" commit(s) on "(_name $current)" not yet on "(_name "origin/$current")":"
            git --no-pager log --color=always \
                --pretty='      %C(yellow)%h%Creset %s %C(dim)(%cr)%Creset' \
                '@{u}..HEAD'
            echo ""
            echo "    Run "(_name "wrangle push")" to push them."
        end
        if test "$behind" -gt 0
            echo "    "(_n $behind)" commit(s) on "(_name "origin/$current")" not yet in "(_name $current)":"
            git --no-pager log --color=always \
                --pretty='      %C(yellow)%h%Creset %s %C(dim)(%cr)%Creset' \
                'HEAD..@{u}'
            echo ""
            echo "    Run "(_name "git pull")" to bring them in."
        end
    end

    # ── Framework update (trunk → this branch) ────────────────────────
    # Commits on origin/main not yet merged into this machine-branch.
    # `wrangle update` performs the merge; status only reports it.
    echo ""
    _subheader "Framework update"
    if not git rev-parse --verify --quiet origin/main >/dev/null
        echo "    $GLYPH_DIM no origin/main on this remote; nothing to update from"
    else
        set -l behind_main (git rev-list --count "$current..origin/main" 2>/dev/null)
        test -z "$behind_main"; and set behind_main 0
        if test "$behind_main" -eq 0
            echo "    $GLYPH_OK "(_name $current)" up to date with "(_name origin/main)
        else
            echo "    "(_n $behind_main)" commit(s) on "(_name origin/main)" not yet in "(_name $current)":"
            git --no-pager log --color=always \
                --pretty='      %C(yellow)%h%Creset %s %C(dim)(%cr)%Creset' \
                "$current..origin/main"
            echo ""
            echo "    Run "(_name "wrangle update")" to merge them in."
        end
    end

    # ── Peer machine-branches ─────────────────────────────────────────
    echo ""
    _subheader "Peer machine-branches"
    set -l peers
    # origin/HEAD's short-form is bare "origin" (git collapses the symbolic
    # ref), so we filter against the full refname rather than the short form.
    for line in (git for-each-ref refs/remotes/origin --format='%(refname) %(refname:short)' 2>/dev/null)
        set -l full (string split -m 1 ' ' -- $line)[1]
        set -l short (string split -m 1 ' ' -- $line)[2]
        test "$full" = refs/remotes/origin/HEAD; and continue
        test "$short" = origin/main;             and continue
        test "$short" = "origin/$current";       and continue
        set -a peers $short
    end
    if test (count $peers) -eq 0
        echo "    $GLYPH_DIM no other branches on origin"
    else
        for ref in $peers
            set -l rel (git log -1 --format='%cr' $ref 2>/dev/null)
            set -l iso (git log -1 --format='%cs' $ref 2>/dev/null)
            echo "    "(_name $ref)" $GLYPH_DIM last updated $rel ($iso)"
        end
        echo ""
        echo "    Run "(_name "wrangle merge <branch>")" to adopt content from one of these."
    end

    popd >/dev/null

    # ── Local drift ───────────────────────────────────────────────────
    # Call the drift passes directly (scripts/_drift.fish). No subprocess
    # and no borrowed flag: status previously re-exec'd
    # `sync --dry-run --no-branch-switch` and used a user-facing flag to
    # mute the pass it didn't want, which is what leaked an empty
    # "Framework update" section into this output.
    #
    # The mutating passes — yoink, re-stow, commit, doc review, push —
    # simply aren't in this call path, so status is read-only by
    # structure rather than by remembering to gate each one.
    echo ""
    _wrangle_detect_drift report
    exit 0
end

# ─── repair ──────────────────────────────────────────────────────────────
# `wrangle repair` — recover a machine whose home/ package will not stow.
#
# home/ is a single stow package, so one path stow cannot store blocks every
# file in it. When that happens, sync stops at Pass 4 on every run, and any
# dotfile that was moved into the repo before the breakage sits there with no
# symlink back into ~. That is a state sync cannot dig itself out of, because
# sync refuses to start — hence a separate subcommand rather than another pass.
#
# Three phases, in dependency order:
#   1. clear the paths stow refuses, moving them back to ~
#   2. re-stow, which links back everything stranded by the breakage
#   3. clear symlinks in ~ left pointing at paths no longer in home/
#
# --dry-run reports all three without prompting or writing.
if test "$_subcmd" = repair
    set -l dry no
    set -q _flag_dry_run; and set dry yes

    _header "Repair"
    if test "$dry" = yes
        echo "  Dry run — reporting only, nothing will be changed."
    end

    # ── 1. Paths stow will not store ──────────────────────────────────
    echo ""
    _subheader "Unstowable paths in home/"
    set -l hazards (_wrangle_stow_hazards $home_subdir)
    set -l untracked_count 0

    if test (count $hazards) -eq 0
        echo "    $GLYPH_OK nothing in "(_name home/)" that stow refuses"
    else
        echo "    "(_n (count $hazards))" path(s) stow will not store:"
        echo ""
        _wrangle_stow_hazard_report "    " $hazards

        for h in $hazards
            set -l hpath (string split \t -- $h)[2]
            set -l rel (string replace -- "$home_subdir/" "" $hpath)
            set -l target $HOME/$rel

            echo ""
            echo "    "(_name "home/$rel")
            if test "$dry" = yes
                echo "      $GLYPH_DIM would offer to move back to "(_name "~/$rel")
                continue
            end

            while true
                read -P (_keys "    [u]ntrack (move back to ~) / [s]kip / [q]uit > ") choice
                switch $choice
                    case u U untrack
                        if test -e $target; or test -L $target
                            echo "      $GLYPH_ERR "(_name "~/$rel")" already exists — not overwriting it."
                            echo "        Move or remove it yourself, then re-run "(_name "wrangle repair")"."
                            break
                        end
                        mkdir -p (dirname $target)
                        if mv $hpath $target
                            echo "      $GLYPH_OK moved back to "(_name "~/$rel")
                            set untracked_count (math $untracked_count + 1)
                            _log_change "untracked unstowable path: $rel"
                        else
                            echo "      $GLYPH_ERR mv failed; left in place"
                        end
                        break
                    case s S skip ''
                        echo "      $GLYPH_DIM skipped"
                        break
                    case q Q quit
                        _wrangle_abort quit
                    case '*'
                        echo "      ? '$choice' — answer u/s/q"
                end
            end
        end
    end

    # ── 2. Re-stow ────────────────────────────────────────────────────
    # With the package no longer blocked, this links back every path that was
    # moved into home/ but never symlinked — the actual repair.
    echo ""
    _subheader "Re-stow"
    if not command -q stow
        echo "    $GLYPH_WARN stow not installed; cannot re-stow."
    else if test "$dry" = yes
        echo "    $GLYPH_DIM would re-stow "(_name home/)" into ~"
    else if _wrangle_stow_run "Re-stowing home/ into ~…" $repo
        echo "    $GLYPH_OK "(_name home/)" is stowed into ~"
    else
        echo "    $GLYPH_ERR stow still refuses "(_name home/)":"
        _wrangle_stow_explain_failure "      " $_wrangle_stow_err
        echo ""
        echo "    Resolve the path named above and re-run "(_name "wrangle repair")"."
        exit 1
    end

    # ── 3. Dangling symlinks ──────────────────────────────────────────
    echo ""
    _subheader "Dangling symlinks"
    set -l orphans (_wrangle_orphan_symlinks $home_subdir)
    set -l removed_count 0

    if test (count $orphans) -eq 0
        echo "    $GLYPH_OK no symlinks in ~ pointing at missing paths in home/"
    else
        for path in $orphans
            echo ""
            echo "    "(_name $path)" $GLYPH_ARROW "(_name (readlink $path))
            if test "$dry" = yes
                echo "      $GLYPH_DIM would offer to remove it"
                continue
            end
            while true
                read -P (_keys "    [r]emove dangling symlink / [s]kip / [q]uit > ") choice
                switch $choice
                    case r R remove
                        rm $path
                        echo "      $GLYPH_OK removed"
                        set removed_count (math $removed_count + 1)
                        _log_change "removed orphan symlink: $path"
                        break
                    case s S skip ''
                        echo "      $GLYPH_DIM skipped"
                        break
                    case q Q quit
                        _wrangle_abort quit
                    case '*'
                        echo "      ? '$choice' — answer r/s/q"
                end
            end
        end
    end

    # Paths moved back out of home/ leave the repo dirty. Say so rather than
    # committing: what to do with them is the user's call, and the next sync
    # will offer them again (and refuse to track them again, for the same
    # reason they were moved back).
    echo ""
    if test "$dry" = yes
        echo "  $GLYPH_DIM dry run — nothing was changed."
    else
        echo "  $GLYPH_OK "(_n $untracked_count)" path(s) moved back to ~, "(_n $removed_count)" dangling symlink(s) removed."
        if test $untracked_count -gt 0
            echo "    "(_name home/)" has uncommitted deletions. Run "(_name "wrangle sync")" to review and commit them."
        end
    end
    exit 0
end

# `$_claude_opt` (on/off) is computed later — right after the first-run
# opt-in question runs (so the just-saved answer is honored this run). Pass 10
# (commit message) and Pass 11 (doc-sync) both read it.

# ─── Commit-message builders ─────────────────────────────────────────────
# Three-path strategy:
#   1. Single structural change → use it directly. claude can't improve much.
#   2. claude opt-in is on (and CLI present) → ask claude to summarize the diff.
#   3. Fall back to heuristic. For hand-edits (empty $_changes) describes the
#      file count; for multi-change uses "$first (+N more)".
#
# The plain builder `_build_commit_msg` lives in scripts/_commit_msg.fish
# (sourced at the top of this script). `_build_commit_msg_via_claude` stays
# here because it shells out to the claude CLI; the extracted plain builder
# calls into it.
#
# Stateless — fresh session every invocation (commit messages don't need
# conversation continuity, and we don't want to pollute the doc-review session).
function _build_commit_msg_via_claude --argument-names repo
    set -l changes $argv[2..-1]
    set -l diff (git -C $repo diff --cached 2>/dev/null | head -300)
    test -z "$diff"; and return 1

    set -l changes_str ""
    for c in $changes
        set changes_str "$changes_str- $c"\n
    end

    set -l prompt "Write a git commit message for this staged diff in a dotfiles repo.

Wrangle's own log of decisions this run (may be empty if these are hand-edits):
$changes_str
Staged diff (first 300 lines):
```
$diff
```

Rules:
- One-line subject, lowercase, no trailing period, prefer < 70 chars
- Describe the change cohesively; if multiple unrelated things, summarize
- Prefix with 'wrangle: ' if the change was wrangle-initiated; omit for user hand-edits
- Output ONLY the commit message subject line, no preamble, no explanation, no code fences, no quotes"

    set -l model sonnet
    set -l effort low
    test -n "$WRANGLE_CLAUDE_MODEL"; and set model "$WRANGLE_CLAUDE_MODEL"
    test -n "$WRANGLE_CLAUDE_EFFORT"; and set effort "$WRANGLE_CLAUDE_EFFORT"

    _spinner_start "Asking claude for a commit message…"
    set -l msg (claude -p --output-format text --model $model --effort $effort "$prompt" 2>/dev/null | string trim)
    _spinner_stop

    # Strip stray surrounding quotes/backticks claude sometimes adds.
    set msg (string replace -ra '^["`]+|["`]+$' '' -- $msg)
    test -z "$msg"; and return 1
    echo $msg
end

# ─── Sync pipeline ───────────────────────────────────────────────────────
# The numbered passes below run in order for `wrangle sync`. Each pass owns
# one drift domain (or one finalization step). Subcommand handlers above
# exited before reaching this point.

# ─── Pass 1: framework update ────────────────────────────────────────────
# Auto-switch to the machine-branch (default: personal), then merge
# origin/main into it (the framework update). Single edge — no chain.
# Skip with --no-branch-switch / WRANGLE_NO_BRANCH_SWITCH=1.
# In --dry-run mode the switch is reported but not performed — dry-run
# must have no side effects, including no checkout.
#
# The header prints inside each branch, not above them, so a skipped pass
# leaves no empty section behind. The two skip causes are reported
# differently on purpose:
#   --no-branch-switch        → silent. You typed the flag a second ago;
#                               echoing it back says nothing you don't know.
#   WRANGLE_NO_BRANCH_SWITCH  → explained. An exported var set once and
#                               forgotten otherwise lets the machine-branch
#                               drift behind main with no visible reason.
if set -q _flag_no_branch_switch
    # Explicitly requested for this run — nothing to report.
else if test -n "$WRANGLE_NO_BRANCH_SWITCH"
    _header "Framework update"
    set -l machine_branch (_wrangle_machine_branch $repo)
    echo "  $GLYPH_WARN WRANGLE_NO_BRANCH_SWITCH=1 is set in your environment — "(_name origin/main)" was not merged into "(_name $machine_branch)"."
    echo "  Run "(_name "wrangle update")" to merge it now, or unset the variable."
else
    _header "Framework update"
    pushd $repo >/dev/null

    set -l machine_branch (_wrangle_machine_branch $repo)
    set -l current_branch (git rev-parse --abbrev-ref HEAD)
    if test "$current_branch" != "$machine_branch"
        if test "$_dry_run" = yes
            echo "  $GLYPH_ARROW would switch to "(_name $machine_branch)" (currently on "(_name $current_branch)")"
        else if git show-ref --verify --quiet refs/heads/$machine_branch
            _with_spinner "Switching to $machine_branch…" git checkout $machine_branch 2>&1
            echo "  $GLYPH_ARROW switched to "(_name $machine_branch)" (was on "(_name $current_branch)")"
        else
            _with_spinner "Creating $machine_branch from main…" git checkout -b $machine_branch main 2>&1
            echo "  $GLYPH_ARROW created + switched to "(_name $machine_branch)" from "(_name main)" (was on "(_name $current_branch)")"
        end
    end

    popd >/dev/null

    if test "$_dry_run" = no
        if git -C $repo remote | grep -q .
            _wrangle_update
            set -l update_rv $status
            if test $update_rv -ne 0
                # Merge conflict. Exit so user can resolve.
                exit $update_rv
            end
        end
    else
        echo "  $GLYPH_DIM dry run — would fetch origin and merge origin/main into "(_name $machine_branch)
    end
end


# ─── First-run welcome + claude opt-in ───────────────────────────────────
# Two one-shot interactives that fire on the very first sync on a new
# machine, before any drift detection. The welcome banner introduces
# wrangle; the claude opt-in question gates the doc-sync pass (Pass 11)
# and the claude-assisted commit message (Pass 10).

if test "$_first_run" = yes; and test "$_dry_run" = no
    echo ""
    _header "First wrangle on this machine"
    echo "  I'll walk through what's already in ~ and ask what to track."
    echo "  Everything is non-destructive — nothing gets moved or modified"
    echo "  unless you say [t]rack."
    echo ""
end

# Claude opt-in question.
# Fires the first time wrangle is run *after the opt-in feature exists* —
# i.e., whenever $config_file is missing. Decoupled from $_first_run (which
# only catches truly-fresh machines) so existing users get asked the first
# time they run a wrangle version that knows about the question. Asked HERE
# (rather than at the end of the run) so the answer applies to THIS run's
# doc-sync, not just future runs.
if test "$_dry_run" = no; and not test -f $config_file
    echo ""
    _header "One-time question"
    echo "  wrangle can optionally use claude-code (the `claude` CLI) after each run"
    echo "  to review the repo's docs (framework and personal-layer) for changes that"
    echo "  need reflecting. It runs only when wrangle has actual changes, uses a"
    echo "  persistent session to avoid re-reading the repo each time, and obeys"
    echo "  --with-claude / --suppress-claude flags on individual runs."
    echo ""
    set -l answer no
    while true
        read -P (_keys "  Enable claude doc review by default on this machine? [y/N] > ") choice
        switch $choice
            case y Y yes
                set answer yes
                break
            case n N no ''
                set answer no
                break
            case '*'
                echo "  ? '$choice' — y or n"
        end
    end
    echo "WRANGLE_CLAUDE_OPT_IN=$answer" > $config_file
    echo "  $GLYPH_OK Saved to $config_file (edit that file to change later)."
end

# Determine effective claude opt-in for THIS run. Computed here (after the
# opt-in question) so a first-run "yes" answer takes effect immediately.
#   --suppress-claude       → off (overrides file)
#   --with-claude           → on (overrides file)
#   WRANGLE_CLAUDE_OPT_IN=yes in $config_file → on
#   else → off
set -g _claude_opt off
if test -f $config_file
    if grep -q 'WRANGLE_CLAUDE_OPT_IN=yes' $config_file
        set _claude_opt on
    end
end
set -q _flag_with_claude; and set _claude_opt on
set -q _flag_suppress_claude; and set _claude_opt off

# ─── Pass 2: yoink check ─────────────────────────────────────────────────
set -l yoink_candidates
if test "$_dry_run" = no; and test "$_first_run" = no
    set -l has_stow_links no
    for f in $HOME/.gitconfig $HOME/.vim/vimrc $HOME/.config/fish/config.fish
        if test -L $f; and string match -q "*$repo/*" -- (readlink $f)
            set has_stow_links yes
            break
        end
    end
    if test "$has_stow_links" = yes
        for f in (find $home_subdir -type f -not -name .gitkeep 2>/dev/null)
            set -l rel (string replace -- "$home_subdir/" "" $f)
            set -l target $HOME/$rel
            if not test -e $target; and not test -L $target
                set -a yoink_candidates $rel
            end
        end
    end
end

if test (count $yoink_candidates) -gt 0
    _header "Yoink check"
    echo "  Files in home/ but missing from ~ ("(_n (count $yoink_candidates))") — looks like you removed them:"
    for rel in $yoink_candidates
        echo ""
        echo "    "(_name "home/$rel")
        while true
            read -P (_keys "    [y]oink (remove from repo) / [r]estore (stow back) / [s]kip / [q]uit > ") choice
            switch $choice
                case y Y yoink
                    rm $home_subdir/$rel
                    set -l parent (dirname $home_subdir/$rel)
                    while test "$parent" != "$home_subdir"; and test -z "$(ls -A $parent 2>/dev/null)"
                        rmdir $parent
                        set parent (dirname $parent)
                    end
                    echo "      $GLYPH_OK removed home/$rel"
                    _log_change "yoinked dotfile: $rel"
                    break
                case r R restore
                    echo "      $GLYPH_DIM will restore via stow"
                    break
                case s S skip ''
                    echo "      $GLYPH_DIM skipped"
                    break
                case q Q quit
                    _wrangle_abort quit
                case '*'
                    echo "      ? '$choice' — answer y/r/s/q"
            end
        end
    end
end

# ─── Pass 3: orphan-symlink check ────────────────────────────────────────
# Inverse of the yoink check above: ~ has a symlink pointing into the repo,
# but the source file in home/ no longer exists (e.g., you deleted it from
# home/ directly without unstowing first). `stow -R` leaves these behind.
# Find and clean them up before Pass 4 (re-stow) so subsequent installs
# don't trip over "conflicting file" errors.
#
# Detection lives in scripts/_stow_guard.fish, shared with `wrangle repair`.
# The version that used to be inline here could not match anything: it ran
# each candidate through realpath to decide whether it pointed into the repo,
# but it only ever examined links it had already established were broken, and
# BSD realpath (macOS) exits 1 without output on a path that does not resolve.
# $tgt was always empty, so the prefix match always failed.
set -l orphan_symlinks
if test "$_dry_run" = no
    set orphan_symlinks (_wrangle_orphan_symlinks $home_subdir)
end

if test (count $orphan_symlinks) -gt 0
    echo ""
    _header "Orphan symlinks"
    echo "  Symlinks in ~ pointing into home/ whose targets no longer exist ("(_n (count $orphan_symlinks))"):"
    for path in $orphan_symlinks
        echo ""
        echo "    "(_name $path)" $GLYPH_ARROW "(_name (readlink $path))
        while true
            read -P (_keys "    [r]emove dangling symlink / [s]kip / [q]uit > ") choice
            switch $choice
                case r R remove
                    rm $path
                    echo "      $GLYPH_OK removed $path"
                    _log_change "removed orphan symlink: $path"
                    break
                case s S skip ''
                    echo "      $GLYPH_DIM skipped"
                    break
                case q Q quit
                    _wrangle_abort quit
                case '*'
                    echo "      ? '$choice' — answer r/s/q"
            end
        end
    end
end

# ─── Pass 4: re-stow ─────────────────────────────────────────────────────
if command -q stow
    if test "$_dry_run" = no
        _wrangle_stow_run "Re-stowing home/ into ~…" $repo
        or begin
            # This is the gate a machine with an already-broken home/ hits on
            # every run, so it has to name the actual cause. It used to say
            # "resolve conflicts (real files at target paths)", which is only
            # one of the several things stow refuses, and named no path at all.
            echo ""
            echo "$GLYPH_ERR STOW REFUSED — home/ could not be linked into ~:"
            _wrangle_stow_explain_failure "    " $_wrangle_stow_err
            echo ""
            echo "  Nothing was changed. home/ is a single stow package, so one"
            echo "  bad path blocks every file in it."
            echo "  Run "(_name "wrangle repair")" to find and fix it."
            exit 1
        end
    end
else
    echo "$GLYPH_WARN stow not installed; skipping re-stow."
end

# ─── Passes 5-8: drift detection ─────────────────────────────────────────
# Dotfiles, fisher plugins, universal variables, brew — the four domains
# that report drift in both modes. The passes live in scripts/_drift.fish
# (sourced above) so `wrangle status` can run them without running this
# pipeline; see the header comment there for why.
#
# --dry-run is a user flag about this run; `report` is the contract the
# drift unit is being invoked under. Translating here keeps the flag from
# leaking into the extracted unit as ambient state.
set -l _drift_mode interactive
test "$_dry_run" = yes; and set _drift_mode report
_wrangle_detect_drift $_drift_mode

# ─── Touch timestamp ──────────────────────────────────────────────────────
if test "$_dry_run" = no
    touch $last_run_stamp
end

# ─── Pass 9: changelog ───────────────────────────────────────────────────
if test "$_dry_run" = no; and test (count $_changes) -gt 0
    for c in $_changes
        echo (date -Iseconds)" $c" >> $changelog_file
    end
end

# ─── Pass 10: commit (push happens later, after optional doc-sync) ───────
set -g _committed no
if test "$_dry_run" = no; and test -z "$WRANGLE_NO_COMMIT"
    pushd $repo >/dev/null
    if test (git status --porcelain | count) -gt 0
        echo ""
        _header "Commit"
        git add -A

        if test -z "$WRANGLE_ALLOW_SECRETS"
            _spinner_start "Scanning staged diff for secrets…"
            set -l secret_hits (git diff --cached | $repo/scripts/scan-secrets)
            _spinner_stop
            if test (count $secret_hits) -gt 0
                echo ""
                echo "$GLYPH_ERR SECRET-LIKE PATTERNS in staged diff — refusing to commit:"
                for h in $secret_hits
                    echo "    $h"
                end
                echo ""
                echo "Either remove the offending content, or bypass with WRANGLE_ALLOW_SECRETS=1 and re-run."
                echo "To unstage: cd $repo && git reset"
                popd >/dev/null
                exit 1
            end
        end

        set -l commit_msg (_build_commit_msg $repo $_claude_opt $_changes)
        _with_spinner "Committing…" git commit -m "$commit_msg"
        set -g _committed yes
        echo "  $GLYPH_OK committed: $commit_msg"
    end
    popd >/dev/null
end

# ─── Pass 11: claude-code doc review (opt-in) ────────────────────────────
# Runs AFTER the main commit but BEFORE the push, so any doc edits claude
# makes get committed (as a separate "docs:" commit so provenance is clear)
# and pushed in the same batch instead of leaving a dangling doc commit for
# next run. claude is invoked with --permission-mode acceptEdits so it can
# actually edit the .md files (was previously sandbox-blocked).
if test "$_dry_run" = no; and test "$_committed" = yes; and test "$_claude_opt" = on
    if not command -q claude
        echo "  $GLYPH_DIM claude not installed; skipping doc review."
    else
        echo ""
        _header "Doc sync"

        # Build context: changes from this run + any pending from prior runs.
        set -l prompt_text "You are claude-code invoked by `wrangle` at $repo. Your job: keep the repo's documentation aligned with reality as changes accumulate.

The repo has two documentation tiers:
  - FRAMEWORK docs describe the sync system itself: README.md and setup-new-machine.md at the repo root. They live on `main` and should stay opinion-free (no presumption of specific tools, no personal preferences). Edit these only if the framework itself changed in a way that makes existing text factually wrong.
  - PERSONAL docs describe the user's specific layer on top: post-bootstrap manual steps, tool-specific auth flows, machine-specific setup notes. These live on the machine-branch (default: `personal`). Create or update them when the machine-branch (Brewfile, tracked dotfiles, fish_plugins) adds something with known post-install or first-time-setup needs that aren't documented elsewhere. A common convention is a top-level PERSONAL.md, but you can split into multiple docs if it makes sense.

You MAY edit any .md file in the repo, and create new .md files when warranted. You MUST NOT touch anything under scripts/, the Brewfile, fish_plugins, .dotignore, .brewignore, .fisherignore, .gitignore, any file under home/, or any dotfile/dotdir (including .claude/, .git/, .github/). Those are managed by other parts of the system.

Only the Edit, Write, Read, Grep, and Glob tools are available to you. Don't attempt Bash, WebFetch, Task, etc. — there's no TTY to approve them and they'll fail. Don't waste turns on tools that aren't whitelisted.

Be conservative: only act on changes that have real user-facing setup or behavior consequences. Skip cosmetic or trivial diffs.

Changes from this wrangle run:
"
        for c in $_changes
            set prompt_text "$prompt_text- $c
"
        end
        set prompt_text "$prompt_text
Recent commit history (for context — last 10 commits):
"
        set -l recent_log (git -C $repo log --oneline -10 2>/dev/null)
        for l in $recent_log
            set prompt_text "$prompt_text  $l
"
        end

        _wrangle_invoke_claude "$prompt_text"
        set -l rv $status
        echo ""
        if test $rv -ne 0
            echo "  $GLYPH_WARN claude exited non-zero ($rv); skipping doc commit."
        else
            pushd $repo >/dev/null
            if test (git status --porcelain | count) -eq 0
                echo "  $GLYPH_OK no doc changes warranted by this run."
            else
                # Sanity check: claude was told to only touch .md files. If it
                # modified anything else, warn loudly and leave it for the user
                # to inspect rather than committing it.
                set -l changed (git status --porcelain | awk '{print $2}')
                set -l non_md
                for f in $changed
                    string match -q '*.md' $f; or set -a non_md $f
                end
                if test (count $non_md) -gt 0
                    echo "  $GLYPH_WARN claude modified non-doc files; NOT committing:"
                    for f in $non_md
                        echo "    $f"
                    end
                    echo "  Inspect / clean up with: cd $repo && git status"
                else
                    git add -A
                    _with_spinner "Committing doc changes…" git commit -m "docs: sync with wrangle run "(date -u +%Y-%m-%dT%H:%MZ)
                    echo "  $GLYPH_OK doc changes committed."
                    _log_change "doc-sync committed by claude"
                end
            end
            popd >/dev/null
        end
    end
end

# ─── Pass 12: push (with preview + y/N/d prompt) ─────────────────────────
# Split out from the commit pass so doc-sync can interject its own commit
# between the two. Calls _wrangle_do_push in 'prompt' mode (show preview, ask
# before pushing); the `wrangle push` subcommand calls it in 'immediate' mode.
if test "$_dry_run" = no; and test -z "$WRANGLE_NO_PUSH"
    pushd $repo >/dev/null
    set -l _unpushed (git rev-list --count '@{u}..HEAD' 2>/dev/null)
    if test -n "$_unpushed"; and test $_unpushed -gt 0
        echo ""
        _header "Push"
        _wrangle_do_push prompt
    end
    popd >/dev/null
end

