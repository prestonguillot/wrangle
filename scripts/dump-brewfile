#!/usr/bin/env fish
# dump-brewfile — `brew bundle dump --force` with .brewignore filtering.
#
# Usage:
#   dump-brewfile [TARGET]              # normal: dump from brew, filter, write to TARGET
#   dump-brewfile --input INPUT TARGET  # testing: filter INPUT instead of calling brew
#   TARGET defaults to <repo>/Brewfile.
#
# .brewignore contains substring patterns (one per line). Any line in the dumped
# Brewfile containing a pattern as a substring is removed, along with the
# preceding `# description` comment if any.

argparse h/help v/verbose input= ignore-file= -- $argv
or exit 1

if set -q _flag_help
    echo "Usage: dump-brewfile [TARGET]"
    echo "       dump-brewfile [--input INPUT] [--ignore-file FILE] [-v|--verbose] TARGET"
    echo ""
    echo "Wraps 'brew bundle dump --force --file=TARGET' with .brewignore filtering."
    echo "  --input FILE        filter FILE instead of calling brew (for tests)"
    echo "  --ignore-file FILE  use FILE as ignore list instead of <repo>/.brewignore"
    echo "  -v, --verbose       emit each filtered (dropped) line to stderr with the matched pattern"
    echo "TARGET defaults to <repo>/Brewfile."
    exit 0
end

set -l script_dir (dirname (realpath (status -f)))
set -l repo (git -C $script_dir rev-parse --show-toplevel 2>/dev/null)
if test -z "$repo"
    echo "✗ dump-brewfile must run inside a git repo."
    exit 1
end

set -l target $argv[1]
test -z "$target"; and set target $repo/Brewfile

set -l ignore_file $repo/.brewignore
set -q _flag_ignore_file; and set ignore_file $_flag_ignore_file
set -l tmp_dump (mktemp)

if set -q _flag_input
    # Test mode — use the provided file as input instead of asking brew.
    if not test -f $_flag_input
        echo "✗ --input file not found: $_flag_input" >&2
        rm -f $tmp_dump
        exit 1
    end
    cp $_flag_input $tmp_dump
else
    # Don't add `--describe` to get description comments: Homebrew 7 disabled
    # the switch, and passing it aborts the whole dump.
    #
    # Don't redirect stderr either — it carries the reason a dump failed, and
    # the caller prints it. stdout is dropped to hide brew's API-cache chatter
    # ("✔︎ JSON API cask.jws.json … Downloaded …MB").
    brew bundle dump --force --file $tmp_dump >/dev/null
    or begin
        rm -f $tmp_dump
        exit 1
    end
end

# No ignore file or empty? Just hand over the raw dump.
if not test -f $ignore_file
    mv $tmp_dump $target
    exit 0
end

set -l patterns (cat $ignore_file | grep -v '^#' | grep -v '^$')
if test (count $patterns) -eq 0
    mv $tmp_dump $target
    exit 0
end

# Filter: drop any line containing a pattern as substring; drop its preceding
# comment line too, so a hand-written "# desc\nbrew "x"" pair goes as a unit
# and does not leave the description orphaned above the next entry.
set -l tmp_filtered (mktemp)
set -l pending ""
while read -l line
    if string match -qr '^#' -- "$line"
        test -n "$pending"; and echo "$pending" >> $tmp_filtered
        set pending $line
        continue
    end

    set -l matched no
    set -l matched_pat
    for p in $patterns
        if string match -q "*$p*" -- "$line"
            set matched yes
            set matched_pat $p
            break
        end
    end

    if test "$matched" = yes
        set -q _flag_verbose; and echo "$line	(matches .brewignore: $matched_pat)" >&2
        set pending ""  # also drop the held comment
    else
        test -n "$pending"; and echo "$pending" >> $tmp_filtered
        echo "$line" >> $tmp_filtered
        set pending ""
    end
end < $tmp_dump
test -n "$pending"; and echo "$pending" >> $tmp_filtered

mv $tmp_filtered $target
rm -f $tmp_dump
