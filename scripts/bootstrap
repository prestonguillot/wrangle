#!/usr/bin/env bash
# bootstrap — set up this dotfiles system on a fresh OR existing macOS machine.
#
# Safe by design: nothing here overwrites user files. The only `~` writes are:
#   - Append fish to /etc/shells (idempotent; only if absent)
#   - chsh to fish (only if your current shell isn't already fish)
#   - Stow the framework (creates symlinks for files that don't exist in ~)
#   - Run `wrangle` for the first sync (interactive; you decide what gets tracked)
#
# Re-runnable: every step is idempotent. Safe to run on a machine that's
# partially set up.

set -eu

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
echo "→ Repo: $REPO_DIR"
echo

# ── 1. Homebrew ─────────────────────────────────────────────────────────
if command -v brew >/dev/null 2>&1; then
    echo "✓ Homebrew already installed"
else
    echo "→ Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Source brew shellenv for the remainder of this script.
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
else
    echo "✗ Homebrew not on PATH after install. Aborting." >&2
    exit 1
fi

# ── 2. Minimum bootstrap kit ────────────────────────────────────────────
# These are the only formulae the framework itself actually requires:
#   fish — the shell wrangle/dump-brewfile/scan-secrets are written in
#   stow — manages the symlinks from home/ into ~
#   git  — already needed if you cloned this repo, but pin it for clarity
#   mas  — the only CLI gateway to the Mac App Store; without it, `brew
#          bundle dump` can't see MAS apps. Idle if you never install one.
echo
echo "→ Installing minimum kit (fish, stow, git, mas)..."
brew install fish stow git mas

FISH_PATH="$(brew --prefix)/bin/fish"

# ── 3. Add fish to /etc/shells ──────────────────────────────────────────
if grep -qxF "$FISH_PATH" /etc/shells 2>/dev/null; then
    echo "✓ $FISH_PATH already in /etc/shells"
else
    echo "→ Adding $FISH_PATH to /etc/shells (may prompt for sudo)..."
    echo "$FISH_PATH" | sudo tee -a /etc/shells >/dev/null
fi

# ── 4. chsh to fish (only if not already) ───────────────────────────────
CURRENT_SHELL="$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}')"
if [ "$CURRENT_SHELL" = "$FISH_PATH" ]; then
    echo "✓ Login shell already $FISH_PATH"
else
    echo "→ Changing login shell to $FISH_PATH (may prompt for password)..."
    chsh -s "$FISH_PATH"
fi

# ── 5. Pick this machine's branch + (optional) seed source ──────────────
# Framework lives on `main` (shared, public-shippable). Each machine owns
# one branch (default name: `personal`) for its own state. Machines are
# peers — they diverge freely after init.
#
# A fresh machine-branch is created from `main`. Optionally you can seed
# it from another existing machine-branch (one-time copy of starting
# state); no persistent relationship is set up.
#
# To pull framework updates later: `wrangle update`.
# To pull personal-layer content from another machine: `wrangle merge <branch>`.
echo
cd "$REPO_DIR"
CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# If we already have a configured machine-branch (re-running bootstrap), reuse it.
EXISTING_MB="$(git config wrangle.machine-branch 2>/dev/null || true)"

if [ -n "$EXISTING_MB" ] && git show-ref --verify --quiet "refs/heads/$EXISTING_MB"; then
    echo "✓ Machine-branch already configured: $EXISTING_MB"
    MB="$EXISTING_MB"
    if [ "$CURRENT_BRANCH" != "$MB" ]; then
        echo "→ Switching to $MB..."
        git checkout "$MB"
    fi
else
    DEFAULT_MB=personal
    printf "→ Branch name for this machine? [%s] " "$DEFAULT_MB"
    read -r MB
    [ -z "$MB" ] && MB="$DEFAULT_MB"

    if git show-ref --verify --quiet "refs/heads/$MB"; then
        echo "→ Switching to existing local branch $MB..."
        git checkout "$MB"
    elif git ls-remote --exit-code --heads origin "$MB" >/dev/null 2>&1; then
        echo "→ Checking out $MB from origin..."
        git checkout -b "$MB" "origin/$MB"
    else
        # Optionally seed from another machine-branch (one-time copy, no
        # persistent relationship). Empty answer → seed from main.
        echo "→ Seed $MB from an existing machine-branch (one-time copy of"
        printf "  its current state), or empty to start from main? [name|<empty>]: "
        read -r SEED
        if [ -z "$SEED" ] || [ "$SEED" = main ]; then
            SEED=main
        fi
        # Resolve seed: prefer origin/<seed>, fall back to local.
        if git show-ref --verify --quiet "refs/heads/$SEED"; then
            SEED_REF="$SEED"
        elif git ls-remote --exit-code --heads origin "$SEED" >/dev/null 2>&1; then
            echo "→ Creating local $SEED tracking origin/$SEED..."
            git branch "$SEED" "origin/$SEED"
            SEED_REF="$SEED"
        else
            echo "✗ Seed branch '$SEED' doesn't exist locally or on origin." >&2
            echo "  Pick a different seed (e.g. main, or leave empty)." >&2
            exit 1
        fi
        echo "→ Creating $MB from $SEED_REF..."
        git checkout -b "$MB" "$SEED_REF"
    fi

    git config wrangle.machine-branch "$MB"
    echo "✓ Machine-branch set to: $MB"

    # Optional: push $MB to a remote NOW so wrangle's later push step has an
    # upstream to talk to. Only prompt when:
    #   - there's exactly one remote (zero = nowhere to push; multiple = user
    #     can set up manually), AND
    #   - the branch has no upstream yet (created-from-origin-$MB above already
    #     set tracking; nothing to do there).
    REMOTES="$(git remote)"
    REMOTE_COUNT="$(printf '%s\n' "$REMOTES" | grep -c .)"
    if ! git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1 && [ "$REMOTE_COUNT" = "1" ]; then
        REMOTE="$REMOTES"
        echo
        echo "→ Push $MB to $REMOTE now? Creates an upstream so \`wrangle sync\`"
        echo "  can push to it on subsequent runs (otherwise sync silently"
        echo "  skips its push step — no upstream means no push prompt)."
        echo
        echo "  WARNING: wrangle's secret-scanner is a regex pass — it catches the"
        echo "  obvious shapes (AWS/GitHub/Slack/Stripe/OpenAI/Anthropic/Google"
        echo "  keys, JWTs, PEM/SSH/PGP blocks) but it doesn't catch every secret."
        echo "  Don't push to a public remote without auditing what's tracked."
        echo
        printf "  Push now? [y]es / [N]o: "
        read -r PUSH_CHOICE
        case "$PUSH_CHOICE" in
            y|Y|yes|Yes|YES)
                if git push -u "$REMOTE" "$MB"; then
                    echo "  ✓ Pushed $MB → $REMOTE/$MB (upstream tracking set)."
                else
                    echo "  ✗ Push failed. Set up remote auth, then re-run:"
                    echo "    git push -u $REMOTE $MB"
                fi
                ;;
            *)
                echo "  → Skipped. To push later: \`git push -u $REMOTE $MB\` or"
                echo "    re-run bootstrap (it'll re-prompt if upstream is still unset)."
                ;;
        esac
    fi
fi

# ── 6. Stow the framework into ~ ────────────────────────────────────────
# On a machine that already has real config files at the paths the repo
# tracks (e.g. ~/.gitconfig, ~/.config/fish/config.fish), stow refuses
# to clobber them. We walk each conflicting path interactively before
# the real stow run, giving you a chance to diff, adopt, keep, or skip.
# Auto-resolves identical files by removing the machine copy so stow can
# link cleanly.
echo
echo "→ Checking for stow conflicts..."

# Pre-flight: dry-run stow to enumerate conflicting target paths (relative
# to $HOME). Stow prints them on stderr; we extract the bit after
# "existing target ".
stow_conflicts() {
    stow --no-folding -t "$HOME" -d "$REPO_DIR" -n home 2>&1 >/dev/null \
        | sed -n 's/.*existing target \(.*\) since neither a link nor a directory.*/\1/p'
}

CONFLICTS_RAW="$(stow_conflicts || true)"

if [ -n "$CONFLICTS_RAW" ]; then
    CONFLICT_COUNT="$(printf '%s\n' "$CONFLICTS_RAW" | grep -c .)"
    echo "→ Found $CONFLICT_COUNT conflicting file(s). Resolving each..."
    echo
    # Iterate line-by-line. Paths from stow don't contain newlines.
    while IFS= read -r REL; do
        [ -z "$REL" ] && continue
        MACHINE="$HOME/$REL"
        REPO_FILE="$REPO_DIR/home/$REL"

        if [ ! -e "$REPO_FILE" ]; then
            echo "  ! $REL: repo file missing at $REPO_FILE — skipping"
            continue
        fi

        # Auto-resolve identical contents: just drop the machine copy.
        if cmp -s "$MACHINE" "$REPO_FILE"; then
            echo "  ✓ $REL: identical contents — removing machine copy so stow can link"
            rm -f "$MACHINE"
            continue
        fi

        # Loop until the user picks a terminal action for this file.
        while true; do
            echo "  ⚠ $REL differs between this machine and the repo."
            printf "    [d]iff / [a]dopt machine's copy into repo / [k]eep repo (move machine aside to .bak) / [s]kip / [q]uit: "
            read -r CHOICE </dev/tty
            case "$CHOICE" in
                d|D)
                    echo "    --- diff: <machine  >repo ---"
                    diff -u "$MACHINE" "$REPO_FILE" || true
                    echo "    --- end diff ---"
                    ;;
                a|A)
                    echo "    → adopting machine's $REL into repo (overwrites tracked copy on this branch)"
                    cp "$MACHINE" "$REPO_FILE"
                    rm -f "$MACHINE"
                    git -C "$REPO_DIR" add "home/$REL"
                    break
                    ;;
                k|K)
                    echo "    → moving $MACHINE to $MACHINE.bak so stow can link the repo's copy"
                    mv "$MACHINE" "$MACHINE.bak"
                    break
                    ;;
                s|S)
                    echo "    → skipped. $REL will remain unlinked until you resolve it later."
                    break
                    ;;
                q|Q)
                    echo "✗ Quit during conflict resolution. Re-run bootstrap to resume." >&2
                    exit 1
                    ;;
                *)
                    echo "    (unknown choice — pick one of d/a/k/s/q)"
                    ;;
            esac
        done
        echo
    done <<< "$CONFLICTS_RAW"

    # If anything got adopted, the index is now dirty; commit so the
    # machine's contributions land on its branch and wrangle has a clean
    # starting point. (No-op if nothing was adopted.)
    if ! git -C "$REPO_DIR" diff --cached --quiet; then
        echo "→ Committing adopted files to $(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD)..."
        git -C "$REPO_DIR" commit -m "bootstrap: adopt pre-existing dotfiles from this machine"
    fi
fi

echo "→ Stowing framework files into ~..."
# Capture both streams and check the status. This used to run bare, so
# "✓ Framework symlinked into ~" printed whether or not anything was linked.
#
# The pre-flight above only recognizes one conflict shape ("since neither a
# link nor a directory"), so it does not catch a home/ holding an absolute
# symlink — stow refuses those outright and links nothing.
if ! STOW_OUT="$(stow --no-folding -t "$HOME" -d "$REPO_DIR" home 2>&1)"; then
    echo "✗ stow refused to link home/ into ~:" >&2
    printf '%s\n' "$STOW_OUT" | sed 's/^/    /' >&2
    echo >&2
    echo "  Nothing was linked. home/ is a single stow package, so one path it" >&2
    echo "  cannot store blocks every file in it. The usual cause is a symlink" >&2
    echo "  to an absolute path, which stow will not store because it could" >&2
    echo "  never remove it again." >&2
    echo "  Remove or replace the path named above, then re-run this script." >&2
    exit 1
fi
echo "✓ Framework symlinked into ~"

# ── 7. Bootstrap fisher (optional, but harmless if already present) ─────
echo
echo "→ Bootstrapping fisher (fish plugin manager)..."
fish -c 'if not functions -q fisher
    curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
    fisher install jorgebucaran/fisher
end' || echo "  (fisher bootstrap had issues; install manually if you want plugins)"

# ── 8. Manual checklist ─────────────────────────────────────────────────
cat <<EOF

────────────────────────────────────────────────────────────
Bootstrap complete.

You're now on the \`$MB\` branch. wrangle will commit your changes here.
Framework updates from upstream flow down the parent chain — wrangle
walks (and merges) the chain at the start of every run.

Anything else you want this machine to have (tools, dotfiles, GUI apps)
should be installed/configured normally — \`wrangle\` will detect it and
walk you through tracking it on the next run.

If you'll be pushing later and haven't set up git auth on this machine
yet, do that now (osxkeychain helper, ssh, gh CLI, etc.) — git will
prompt for credentials on the first push otherwise.

Now launching the first \`wrangle\` run...
────────────────────────────────────────────────────────────

EOF

# ── 9. Force-run the first sync in a login fish so PATH integration is live.
# Bare `wrangle` just prints help (there's no implicit-sync shortcut), so we
# invoke `wrangle sync` explicitly here.
exec "$FISH_PATH" -lc 'wrangle sync'
